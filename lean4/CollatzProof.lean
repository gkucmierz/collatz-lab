-- CZĘŚĆ 27. UNIWERSALNE WYJŚCIE Z MAKRO-EROZJI DWU-ZEROWEJ (`5r + 3` ORAZ `5r + 6` KROKÓW)
--           I BEZWARUNKOWA KONTRAKCJA DLA `r ∈ {0, 1, 2, 3, 4}` (`...0(1)^{3r+1}001₂`)
-- =============================================================================

/-- Każda potęga dziewiątki `9^k` jest dodatnia (`1 ≤ 9^k`): -/
theorem pow9_pos (k : Nat) : 1 ≤ 9 ^ k := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Każda potęga dziewiątki `9^k` jest liczbą nieparzystą (`9^k % 2 = 1`): -/
theorem pow9_odd (k : Nat) : (9 ^ k) % 2 = 1 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Dla dowolnego `B ≥ 1` (zarówno parzystego, jak i nieparzystego) liczba `B * 8 - 7 ≡ 1 (mod 4)`
    w dokładnie 3 krokach Collatza przechodzi w `6 * B - 5`: -/
theorem two_zero_valley_step3_all (B : Nat) (hB : B ≥ 1) :
    collatzIter 3 (B * 8 - 7) = 6 * B - 5 := by
  have s1 : collatzStep (B * 8 - 7) = 24 * B - 20 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (24 * B - 20) = 12 * B - 10 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (12 * B - 10) = 6 * B - 5 := by unfold collatzStep; split <;> omega
  simp [collatzIter, s1, s2, s3]

/-- TWIERDZENIE O UNIWERSALNYM WYJŚCIU Z MAKRO-EROZJI DWU-ZEROWEJ W `5r + 3` KROKACH:
    Dla dowolnego `r ∈ ℕ` oraz `A ≥ 1`:
      `collatzIter (5 * r + 3) (A * 2^(3 * r + 3) - 7) = 6 * (9^r * A) - 5`. -/
theorem two_zero_valley_universal_step3_exit (r A : Nat) (hA : A ≥ 1) :
    collatzIter (5 * r + 3) (A * 2 ^ (3 * r + 3) - 7) = 6 * (9 ^ r * A) - 5 := by
  rw [Nat.add_comm (5 * r) 3, collatzIter_add 3 (5 * r)]
  have hm := two_zero_valley_macro_erosion r A 3 hA (by decide)
  rw [hm]
  have hB : 1 * 1 ≤ 9 ^ r * A := Nat.mul_le_mul (pow9_pos r) hA
  exact two_zero_valley_step3_all (9 ^ r * A) (by omega)

/-- Dla każdego nieparzystego `B` (`B % 2 = 1`) stan `6 * B - 5` w 3 krokach Collatza
    wykonuje 1 krok nieparzysty i 2 kroki parzyste (`v₂ ≥ 2`), dając `(9 * B - 7) / 2`: -/
theorem odd_minus5_step3_div2 (B : Nat) (hB : B % 2 = 1) :
    collatzIter 3 (6 * B - 5) = (9 * B - 7) / 2 := by
  have s1 : collatzStep (6 * B - 5) = 18 * B - 14 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (18 * B - 14) = 9 * B - 7 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (9 * B - 7) = (9 * B - 7) / 2 := by unfold collatzStep; split <;> omega
  simp [collatzIter, s1, s2, s3]

/-- TWIERDZENIE O WYJŚCIU Z MAKRO-EROZJI DLA NIEPARZYSTEGO PREFIKSU `2M + 1` W `5r + 6` KROKACH:
    Gdy blok jedynek nad doliną dwu-zerową `001₂` jest zakończony od góry przynajmniej jednym
    zerem (`A = 2 * M + 1`), po `5 * r + 6` krokach zachodzi dokładna tożsamość zamknięta:
      `collatzIter (5 * r + 6) ((2 * M + 1) * 2^(3 * r + 3) - 7) = (9^(r + 1) * (2 * M + 1) - 7) / 2`. -/
theorem two_zero_valley_odd_prefix_step6_exit (r M : Nat) :
    collatzIter (5 * r + 6) ((2 * M + 1) * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * (2 * M + 1) - 7) / 2 := by
  have h6 : 5 * r + 6 = 3 + (5 * r + 3) := by omega
  rw [h6, collatzIter_add 3 (5 * r + 3)]
  rw [two_zero_valley_universal_step3_exit r (2 * M + 1) (by omega)]
  have h9_odd : (9 ^ r) % 2 = 1 := pow9_odd r
  have hB_decomp : 9 ^ r * (2 * M + 1) = 2 * (9 ^ r * M) + 9 ^ r := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (9 ^ r) 2, Nat.mul_assoc]
  have hB_odd : (9 ^ r * (2 * M + 1)) % 2 = 1 := by omega
  rw [odd_minus5_step3_div2 (9 ^ r * (2 * M + 1)) hB_odd]
  have hpow9 : 9 ^ (r + 1) * (2 * M + 1) = 9 * (9 ^ r * (2 * M + 1)) := by
    rw [Nat.pow_succ, Nat.mul_comm (9 ^ r) 9, Nat.mul_assoc]
  rw [hpow9]

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI RODZINY DWU-ZEROWEJ DLA `r ∈ {0, 1, 2, 3, 4}`:
    Ponieważ `9^(r + 1) < 2 * 8^(r + 1)` dla wszystkich `r ∈ {0, 1, 2, 3, 4}`
    (`9 < 16`, `81 < 128`, `729 < 1024`, `6561 < 8192`, `59049 < 65536`),
    każda liczba postaci `(2 * M + 1) * 2^(3 * r + 3) - 7` (dla dowolnego `M ≥ 1` i `r ≤ 4`)
    ulega ścisłej kontrakcji wysokości w `5 * r + 6` krokach! -/
theorem two_zero_valley_universal_contraction_r0_to_r4 (M : Nat) (hM : M ≥ 1) :
    (collatzIter 6  ((2 * M + 1) * 8     - 7) < (2 * M + 1) * 8     - 7 ∧ HasHorizonDrop ((2 * M + 1) * 8     - 7)) ∧
    (collatzIter 11 ((2 * M + 1) * 64    - 7) < (2 * M + 1) * 64    - 7 ∧ HasHorizonDrop ((2 * M + 1) * 64    - 7)) ∧
    (collatzIter 16 ((2 * M + 1) * 512   - 7) < (2 * M + 1) * 512   - 7 ∧ HasHorizonDrop ((2 * M + 1) * 512   - 7)) ∧
    (collatzIter 21 ((2 * M + 1) * 4096  - 7) < (2 * M + 1) * 4096  - 7 ∧ HasHorizonDrop ((2 * M + 1) * 4096  - 7)) ∧
    (collatzIter 26 ((2 * M + 1) * 32768 - 7) < (2 * M + 1) * 32768 - 7 ∧ HasHorizonDrop ((2 * M + 1) * 32768 - 7)) := by
  have e0 := two_zero_valley_odd_prefix_step6_exit 0 M
  change collatzIter 6  ((2 * M + 1) * 8     - 7) = (9     * (2 * M + 1) - 7) / 2 at e0
  have e1 := two_zero_valley_odd_prefix_step6_exit 1 M
  change collatzIter 11 ((2 * M + 1) * 64    - 7) = (81    * (2 * M + 1) - 7) / 2 at e1
  have e2 := two_zero_valley_odd_prefix_step6_exit 2 M
  change collatzIter 16 ((2 * M + 1) * 512   - 7) = (729   * (2 * M + 1) - 7) / 2 at e2
  have e3 := two_zero_valley_odd_prefix_step6_exit 3 M
  change collatzIter 21 ((2 * M + 1) * 4096  - 7) = (6561  * (2 * M + 1) - 7) / 2 at e3
  have e4 := two_zero_valley_odd_prefix_step6_exit 4 M
  change collatzIter 26 ((2 * M + 1) * 32768 - 7) = (59049 * (2 * M + 1) - 7) / 2 at e4
  refine ⟨⟨by omega, hasHorizonDrop_of_ge_one_and_lt 6  _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 11 _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 16 _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 21 _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 26 _ (by decide) (by omega) (by omega)⟩⟩

