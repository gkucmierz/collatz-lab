/-- Uniwersalna tożsamość wyjścia fazy `d = 4` (`b = 3r + 4 ≡ 1 (mod 3)`) dla ogona `-7`:
    w `5r + 9` krokach z `(2M + 1) * 2^(3r+4) - 7` osiągamy `(9^(r+2) * (2M + 1) - 29) / 2`. -/
theorem two_zero_valley_d4_odd_prefix_step9_exit (r M : Nat) :
    collatzIter (5 * r + 9) ((2 * M + 1) * 2 ^ (3 * r + 4) - 7) =
      (9 ^ (r + 2) * (2 * M + 1) - 29) / 2 := by
  have h9_alt : 5 * r + 9 = 4 + (5 + 5 * r) := by omega
  rw [h9_alt, collatzIter_add 4 (5 + 5 * r), collatzIter_add 5 (5 * r)]
  rw [two_zero_valley_macro_erosion r (2 * M + 1) 4 (by omega) (by decide)]
  let B0 := 9 ^ r * (2 * M + 1)
  have hB0_pos : 1 * 1 ≤ B0 := Nat.mul_le_mul (pow9_pos r) (by omega)
  have h16 : B0 * 2 ^ 4 - 7 = 16 * B0 - 7 := by
    have : 2 ^ 4 = 16 := rfl
    omega
  rw [h16, two_zero_valley_step5 B0 (by omega)]
  have h18 : 18 * B0 - 7 = (9 ^ (r + 1) * (2 * M + 1)) * 2 - 7 := by
    have hpow : 9 ^ (r + 1) * (2 * M + 1) = 9 * B0 := by
      show 9 ^ (r + 1) * (2 * M + 1) = 9 * (9 ^ r * (2 * M + 1))
      rw [Nat.pow_succ, Nat.mul_comm (9 ^ r) 9, Nat.mul_assoc]
    omega
  rw [h18]
  have h9_odd : (9 ^ (r + 1)) % 2 = 1 := pow9_odd (r + 1)
  have hB_decomp : 9 ^ (r + 1) * (2 * M + 1) = 2 * (9 ^ (r + 1) * M) + 9 ^ (r + 1) := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 2, Nat.mul_assoc]
  have hB_odd : (9 ^ (r + 1) * (2 * M + 1)) % 2 = 1 := by omega
  have hB_ge9 : 9 ^ (r + 1) * (2 * M + 1) ≥ 9 := by
    have h9 : 9 ≤ 9 ^ (r + 1) := by
      rw [Nat.pow_succ]
      have := pow9_pos r
      omega
    have := Nat.mul_le_mul h9 (by omega : 1 ≤ 2 * M + 1)
    omega
  rw [two_zero_valley_d1_step4_div2 (9 ^ (r + 1) * (2 * M + 1)) hB_odd hB_ge9]
  have hpow2 : 9 * (9 ^ (r + 1) * (2 * M + 1)) = 9 ^ (r + 2) * (2 * M + 1) := by
    rw [← Nat.mul_assoc 9 (9 ^ (r + 1)) (2 * M + 1), Nat.mul_comm 9 (9 ^ (r + 1))]
    rfl
  rw [hpow2]

/-- Rezonans `mod 8` dla fazy `d = 4` (`-7`): dla `2M + 1 = 8W + 5`,
    w `5r + 11` krokach osiągamy `(9^(r+2) * (8W + 5) - 29) / 8`. -/
theorem two_zero_valley_d4_mod8_resonance_step11 (r W : Nat) :
    collatzIter (5 * r + 11) ((8 * W + 5) * 2 ^ (3 * r + 4) - 7) =
      (9 ^ (r + 2) * (8 * W + 5) - 29) / 8 := by
  have h11 : 5 * r + 11 = 2 + (5 * r + 9) := by omega
  have h8W : 8 * W + 5 = 2 * (4 * W + 2) + 1 := by omega
  rw [h11, collatzIter_add 2 (5 * r + 9), h8W, two_zero_valley_d4_odd_prefix_step9_exit r (4 * W + 2), ← h8W]
  have h9_mod8 : (9 ^ (r + 2)) % 8 = 1 := pow9_mod8_eq1 (r + 2)
  have h9_pos : 1 ≤ 9 ^ (r + 2) := pow9_pos (r + 2)
  have hdecomp : 9 ^ (r + 2) * (8 * W + 5) = 8 * (9 ^ (r + 2) * W) + 5 * 9 ^ (r + 2) := by
    rw [Nat.mul_add, ← Nat.mul_assoc (9 ^ (r + 2)) 8 W, Nat.mul_comm (9 ^ (r + 2)) 8, Nat.mul_assoc 8 (9 ^ (r + 2)) W]
    have h5 : 9 ^ (r + 2) * 5 = 5 * 9 ^ (r + 2) := by omega
    rw [h5]
  have hge81 : 81 ≤ 9 ^ (r + 2) := by
    rw [Nat.pow_add 9 r 2]
    have := pow9_pos r
    omega
  have hdiv8 : (9 ^ (r + 2) * (8 * W + 5) - 29) % 8 = 0 := by omega
  exact div2_step2_eq_div8 (9 ^ (r + 2) * (8 * W + 5) - 29) hdiv8

/-- Twierdzenie o kontrakcji fazy `d = 4` (`-7`) dla `9^(r+2) + 6 ≤ 8 * 2^(3r+4)` (`r = 0..3`): -/
theorem two_zero_valley_d4_mod8_contraction (r W : Nat)
    (hr : 9 ^ (r + 2) + 6 ≤ 8 * 2 ^ (3 * r + 4)) :
    let n0 := (8 * W + 5) * 2 ^ (3 * r + 4) - 7
    collatzIter (5 * r + 11) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := two_zero_valley_d4_mod8_resonance_step11 r W
  let U := 8 * W + 5
  have hle : (9 ^ (r + 2) + 6) * U ≤ (8 * 2 ^ (3 * r + 4)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 8 (2 ^ (3 * r + 4)) U, Nat.mul_comm (2 ^ (3 * r + 4)) U] at hle
  have h81_ge : 81 ≤ 9 ^ (r + 2) := by
    rw [Nat.pow_add 9 r 2]
    have := pow9_pos r
    omega
  have hX_ge : 81 * U ≤ (9 ^ (r + 2)) * U := Nat.mul_le_mul_right U h81_ge
  have hU_ge5 : U ≥ 5 := by omega
  have hlt : collatzIter (5 * r + 11) n0 < n0 := by
    show collatzIter (5 * r + 11) ((8 * W + 5) * 2 ^ (3 * r + 4) - 7) < U * 2 ^ (3 * r + 4) - 7
    rw [hcasc]
    change (9 ^ (r + 2) * U - 29) / 8 < U * 2 ^ (3 * r + 4) - 7
    omega
  have hge1 : collatzIter (5 * r + 11) n0 ≥ 1 := by
    show collatzIter (5 * r + 11) ((8 * W + 5) * 2 ^ (3 * r + 4) - 7) ≥ 1
    rw [hcasc]
    change (9 ^ (r + 2) * U - 29) / 8 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 11) n0 (by omega) hge1 hlt⟩

/-- Dla każdego nieparzystego `B ≥ 3` (`B % 2 = 1`) stan `B * 4 - 5` (`d = 2` rodziny `-5`)
    w 6 krokach Collatza osiąga `(27 * B - 29) / 2`: -/
theorem shifted_valley_d2_step6_div2 (B : Nat) (hB : B % 2 = 1) (hB3 : B ≥ 3) :
    collatzIter 6 (B * 4 - 5) = (27 * B - 29) / 2 := by
  have s1 : collatzStep (B * 4 - 5) = 12 * B - 14 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (12 * B - 14) = 6 * B - 7 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (6 * B - 7) = 18 * B - 20 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (18 * B - 20) = 9 * B - 10 := by unfold collatzStep; split <;> omega
  have s5 : collatzStep (9 * B - 10) = 27 * B - 29 := by unfold collatzStep; split <;> omega
  have s6 : collatzStep (27 * B - 29) = (27 * B - 29) / 2 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (B * 4 - 5)))))) = (27 * B - 29) / 2
  rw [s1, s2, s3, s4, s5, s6]

/-- Uniwersalna tożsamość wyjścia fazy `d = 2` (`b = 3r + 2 ≡ 2 (mod 3)`) dla ogona `-5`:
    dla `r + M ≥ 1`, w `5r + 6` krokach z `(2M + 1) * 2^(3r+2) - 5` osiągamy `(27 * 9^r * (2M + 1) - 29) / 2`. -/
theorem shifted_valley_d2_odd_prefix_step6_exit (r M : Nat) (hM : r + M ≥ 1) :
    collatzIter (5 * r + 6) ((2 * M + 1) * 2 ^ (3 * r + 2) - 5) =
      (27 * 9 ^ r * (2 * M + 1) - 29) / 2 := by
  have h6 : 5 * r + 6 = 6 + 5 * r := by omega
  rw [h6, collatzIter_add 6 (5 * r)]
  rw [shifted_valley_macro_erosion r (2 * M + 1) 2 (by omega) (by decide)]
  have h9_odd : (9 ^ r) % 2 = 1 := pow9_odd r
  have hB_decomp : 9 ^ r * (2 * M + 1) = 2 * (9 ^ r * M) + 9 ^ r := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (9 ^ r) 2, Nat.mul_assoc]
  have hB_odd : (9 ^ r * (2 * M + 1)) % 2 = 1 := by omega
  have hB_ge3 : 9 ^ r * (2 * M + 1) ≥ 3 := by
    cases r with
    | zero =>
      have : M ≥ 1 := by omega
      have : 9 ^ 0 * (2 * M + 1) = 2 * M + 1 := by omega
      omega
    | succ r' =>
      have h9 : 9 ≤ 9 ^ (r' + 1) := by
        rw [Nat.pow_succ]
        have := pow9_pos r'
        omega
      have := Nat.mul_le_mul h9 (by omega : 1 ≤ 2 * M + 1)
      omega
  have hpow2 : (9 ^ r * (2 * M + 1)) * 2 ^ 2 - 5 = (9 ^ r * (2 * M + 1)) * 4 - 5 := rfl
  rw [hpow2, shifted_valley_d2_step6_div2 (9 ^ r * (2 * M + 1)) hB_odd hB_ge3]
  rw [Nat.mul_assoc 27 (9 ^ r) (2 * M + 1)]

/-- Rezonans `mod 8` dla fazy `d = 2` (`-5`): dla `2M + 1 = 8W + 7`,
    w `5r + 8` krokach osiągamy `(27 * 9^r * (8W + 7) - 29) / 8`. -/
theorem shifted_valley_d2_mod8_resonance_step8 (r W : Nat) :
    collatzIter (5 * r + 8) ((8 * W + 7) * 2 ^ (3 * r + 2) - 5) =
      (27 * 9 ^ r * (8 * W + 7) - 29) / 8 := by
  have h8 : 5 * r + 8 = 2 + (5 * r + 6) := by omega
  have h8W : 8 * W + 7 = 2 * (4 * W + 3) + 1 := by omega
  rw [h8, collatzIter_add 2 (5 * r + 6), h8W, shifted_valley_d2_odd_prefix_step6_exit r (4 * W + 3) (by omega), ← h8W]
  have h9_mod8 : (9 ^ r) % 8 = 1 := pow9_mod8_eq1 r
  have h9_pos : 1 ≤ 9 ^ r := pow9_pos r
  have hdecomp : 27 * 9 ^ r * (8 * W + 7) = 8 * (27 * 9 ^ r * W) + 189 * 9 ^ r := by
    rw [Nat.mul_add, ← Nat.mul_assoc (27 * 9 ^ r) 8 W, Nat.mul_comm (27 * 9 ^ r) 8, Nat.mul_assoc 8 (27 * 9 ^ r) W]
    have h189 : 27 * 9 ^ r * 7 = 189 * 9 ^ r := by omega
    rw [h189]
  have hdiv8 : (27 * 9 ^ r * (8 * W + 7) - 29) % 8 = 0 := by omega
  exact div2_step2_eq_div8 (27 * 9 ^ r * (8 * W + 7) - 29) hdiv8

/-- Twierdzenie o kontrakcji fazy `d = 2` (`-5`) dla `27 * 9^r + 2 ≤ 8 * 2^(3r+2)` (`r = 0..1`): -/
theorem shifted_valley_d2_mod8_contraction (r W : Nat)
    (hr : 27 * 9 ^ r + 2 ≤ 8 * 2 ^ (3 * r + 2)) :
    let n0 := (8 * W + 7) * 2 ^ (3 * r + 2) - 5
    collatzIter (5 * r + 8) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := shifted_valley_d2_mod8_resonance_step8 r W
  let U := 8 * W + 7
  have hle : (27 * 9 ^ r + 2) * U ≤ (8 * 2 ^ (3 * r + 2)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 8 (2 ^ (3 * r + 2)) U, Nat.mul_comm (2 ^ (3 * r + 2)) U] at hle
  have h9_pos : 1 ≤ 9 ^ r := pow9_pos r
  have h27_ge : 27 ≤ 27 * 9 ^ r := by omega
  have hX_ge : 27 * U ≤ (27 * 9 ^ r) * U := Nat.mul_le_mul_right U h27_ge
  have hU_ge7 : U ≥ 7 := by omega
  have hlt : collatzIter (5 * r + 8) n0 < n0 := by
    show collatzIter (5 * r + 8) ((8 * W + 7) * 2 ^ (3 * r + 2) - 5) < U * 2 ^ (3 * r + 2) - 5
    rw [hcasc]
    change (27 * 9 ^ r * U - 29) / 8 < U * 2 ^ (3 * r + 2) - 5
    omega
  have hge1 : collatzIter (5 * r + 8) n0 ≥ 1 := by
    show collatzIter (5 * r + 8) ((8 * W + 7) * 2 ^ (3 * r + 2) - 5) ≥ 1
    rw [hcasc]
    change (27 * 9 ^ r * U - 29) / 8 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 8) n0 (by omega) hge1 hlt⟩

theorem two_zero_valley_d4_mod8_drop_r0 (W : Nat) : HasHorizonDrop ((8 * W + 5) * 2 ^ 4 - 7)  := (two_zero_valley_d4_mod8_contraction 0 W (by decide)).2
theorem two_zero_valley_d4_mod8_drop_r1 (W : Nat) : HasHorizonDrop ((8 * W + 5) * 2 ^ 7 - 7)  := (two_zero_valley_d4_mod8_contraction 1 W (by decide)).2
