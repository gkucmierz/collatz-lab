-- =============================================================================
-- CZĘŚĆ 23. DWUPARAMETROWY WERYFIKATOR KASKAD PRÓŻNIOWYCH (`checkVacuumCascade`)
--           ORAZ `(3r + m)`-KROKOWA EROZJA WSZYSTKICH 21 KLAS `mod 32` I `mod 256`
-- =============================================================================

/-- Predykat weryfikujący, czy klasa afiniczna `(a, b)` po `m` krokach trafia dokładnie
    w stan próżni doliny zerowej `(a', 1)` z nieekspansywnym współczynnikiem `a' ≤ a`: -/
def checkVacuumCascade (m a b : Nat) : Bool :=
  if m ≥ 1 then
    match affineIter m a b with
    | some (a', b') => decide (b' = 1 ∧ a' ≤ a ∧ b ≥ 2)
    | none          => false
  else
    false

/-- TWIERDZENIE O POPRAWNOŚCI DWUPARAMETROWEJ KASKADY PRÓŻNIOWEJ (`checkVacuumCascade_sound`):
    Jeżeli `checkVacuumCascade m a b = true`, to dla każdego `r ≥ 0` (odpowiadającego dolinie
    `2 * r` dodatkowych zer) i każdego górnego prefiksu `Q ≥ 0`, liczba `a * (Q * 4^r) + b`
    po dokładnie `3 * r + m` klasycznych krokach Collatza ulega ścisłej kontrakcji wysokości! -/
theorem checkVacuumCascade_sound (m a b : Nat)
    (h : checkVacuumCascade m a b = true) (r Q : Nat) :
    collatzIter (3 * r + m) (a * (Q * 4 ^ r) + b) < a * (Q * 4 ^ r) + b ∧
    HasHorizonDrop (a * (Q * 4 ^ r) + b) := by
  unfold checkVacuumCascade at h
  split at h
  · rename_i hm
    cases hp : affineIter m a b with
    | none =>
      rw [hp] at h
      contradiction
    | some p =>
      rcases p with ⟨a', b'⟩
      rw [hp] at h
      have hdec : b' = 1 ∧ a' ≤ a ∧ b ≥ 2 := of_decide_eq_true h
      rcases hdec with ⟨hb1, ha', hb⟩
      have hiter := affineIter_sound m a b a' b' (Q * 4 ^ r) hp
      have hstep : collatzIter m (a * (Q * 4 ^ r) + b) = (a' * Q) * 4 ^ r + 1 := by
        rw [hiter, hb1, ← Nat.mul_assoc]
      have hcasc : collatzIter (3 * r + m) (a * (Q * 4 ^ r) + b) = 3 ^ r * (a' * Q) + 1 := by
        rw [collatzIter_add (3 * r) m, hstep]
        exact zero_valley_vacuum_inductive r (a' * Q)
      have hpow : 3 ^ r ≤ 4 ^ r := pow3_le_pow4 r
      have hle1 : 3 ^ r * (a' * Q) ≤ 4 ^ r * (a' * Q) :=
        Nat.mul_le_mul_right (a' * Q) hpow
      have hle2 : a' * Q ≤ a * Q :=
        Nat.mul_le_mul_right Q ha'
      have hle3 : 4 ^ r * (a' * Q) ≤ 4 ^ r * (a * Q) :=
        Nat.mul_le_mul_left (4 ^ r) hle2
      have hcomm : a * (Q * 4 ^ r) = 4 ^ r * (a * Q) := by
        rw [← Nat.mul_assoc, Nat.mul_comm (a * Q) (4 ^ r)]
      have hlt : collatzIter (3 * r + m) (a * (Q * 4 ^ r) + b) < a * (Q * 4 ^ r) + b := by
        rw [hcasc, hcomm]
        omega
      have hge1 : collatzIter (3 * r + m) (a * (Q * 4 ^ r) + b) ≥ 1 := by
        rw [hcasc]
        omega
      have hm_pos : 3 * r + m > 0 := by omega
      exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (3 * r + m) _ hm_pos hge1 hlt⟩
  · contradiction

