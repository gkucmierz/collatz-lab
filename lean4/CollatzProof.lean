/-- TWIERDZENIE O REZONANSIE `mod 64` (`v₂ ≥ 6`) FAZY `d = 4` RODZINY `-7` W `5r + 14` KROKACH:
    Ponieważ `29 = 5 + 8 * 3` oraz `(1 + 8s)(29 + 24s) = 29 + 64s(3s + 4) ≡ 29 (mod 64)`,
    dla prefiksu `U = 64 * W + 5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8)` licznik `9^(r + 2) * U - 29`
    dzieli się przez `64`, dając po `5r + 14` krokach dokładnie `(9^(r + 2) * U - 29) / 64`: -/
theorem two_zero_valley_d4_mod64_resonance_step14 (r W : Nat) :
    let U := 64 * W + 5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8)
    collatzIter (5 * r + 14) (U * 2 ^ (3 * r + 4) - 7) =
      (9 ^ (r + 2) * U - 29) / 64 := by
  intro U
  have h14 : 5 * r + 14 = 5 + (5 * r + 9) := by omega
  have hU : U = 2 * (32 * W + 2 + 4 * ((3 * ((r + 2) % 8) + 3) % 8)) + 1 := by omega
  rw [h14, collatzIter_add 5 (5 * r + 9), hU, two_zero_valley_d4_odd_prefix_step9_exit r (32 * W + 2 + 4 * ((3 * ((r + 2) % 8) + 3) % 8)), ← hU]
  have h9_mod64 : (9 ^ (r + 2)) % 64 = 1 + 8 * ((r + 2) % 8) := pow9_mod64 (r + 2)
  have h9_ge81 : 81 ≤ 9 ^ (r + 2) := by
    rw [Nat.pow_succ, Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 2) * U = 64 * (9 ^ (r + 2) * W) + (5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8)) * 9 ^ (r + 2) := by
    show 9 ^ (r + 2) * (64 * W + 5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8)) = _
    have hU2 : 64 * W + 5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8) = 64 * W + (5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 2)) 64, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 2)) (5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8))]
  have hp : (r + 2) % 8 = 0 ∨ (r + 2) % 8 = 1 ∨ (r + 2) % 8 = 2 ∨ (r + 2) % 8 = 3 ∨
            (r + 2) % 8 = 4 ∨ (r + 2) % 8 = 5 ∨ (r + 2) % 8 = 6 ∨ (r + 2) % 8 = 7 := by omega
  have hdiv64 : (9 ^ (r + 2) * U - 29) % 64 = 0 := by
    rcases hp with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
    · rw [hdecomp, h4]; omega
    · rw [hdecomp, h5]; omega
    · rw [hdecomp, h6]; omega
    · rw [hdecomp, h7]; omega
  exact div2_step5_eq_div64 (9 ^ (r + 2) * U - 29) hdiv64

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI `mod 64` FAZY `d = 4` RODZINY `-7` (`r = 0..21`, do `2^67`!): -/
theorem two_zero_valley_d4_mod64_contraction (r W : Nat)
    (hr : 9 ^ (r + 2) + 128 ≤ 64 * 2 ^ (3 * r + 4)) :
    let U := 64 * W + 5 + 8 * ((3 * ((r + 2) % 8) + 3) % 8)
    let n0 := U * 2 ^ (3 * r + 4) - 7
