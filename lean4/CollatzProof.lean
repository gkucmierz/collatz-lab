/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 256` KASKADY RLE `-13` (`r = 0..50`, aż do `2^157`!): -/
theorem rle_10011_mod256_contraction (r W : Nat)
    (hr : 9 ^ (r + 2) + 512 ≤ 256 * 2 ^ (3 * r + 7)) :
    let s := (r + 2 + 8 * ((r + 2) / 2) + 16 * ((r + 2) / 4) + 16 * ((r + 3) / 4)) % 32
    let U := 256 * W + 7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)
    let n0 := U * 2 ^ (3 * r + 7) - 13
    collatzIter (5 * r + 19) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro s U n0
  have hcasc : collatzIter (5 * r + 19) n0 = (9 ^ (r + 2) * U - 7) / 256 :=
    rle_10011_mod256_resonance_step19 r W
  have hle : (9 ^ (r + 2) + 512) * U ≤ (256 * 2 ^ (3 * r + 7)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 256 (2 ^ (3 * r + 7)) U, Nat.mul_comm (2 ^ (3 * r + 7)) U] at hle
  have h81_ge : 81 ≤ 9 ^ (r + 2) := by
    rw [Nat.pow_succ, Nat.pow_succ]
    have := pow9_pos r
    omega
  have hX_ge : 81 * U ≤ 9 ^ (r + 2) * U :=
    Nat.mul_le_mul_right U h81_ge
  have hU_ge7 : U ≥ 7 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 7) - 13 := rfl
  have hlt : collatzIter (5 * r + 19) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 19) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 19) n0 (by omega) hge1 hlt⟩

