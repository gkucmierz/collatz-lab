-- =============================================================================
-- CZĘŚĆ 26. WERYFIKATOR KASKADY PRÓŻNIOWEJ Z NIEPARZYSTYM WYJŚCIEM (`checkOddExitVacuumCascade`)
--           ORAZ DWUPARAMETROWE KASKADY PRÓŻNIOWE MERSENNE'A `M_11 .. M_40`
-- =============================================================================

/-- Weryfikator dwuparametrowej kaskady próżniowej z nieparzystym wyjściem (`v₂ ≥ 3`):
    Sprawdza, czy `affineIter m a b = some (a', 1)` przy nieparzystym współczynniku `a' % 2 = 1`
    (co zachodzi zawsze, gdy `a = 2^k` zużywa wszystkie dzielenia przez 2 i przechodzi w `a' = 3^c`),
    `a' ≤ 2 * a` oraz `b ≥ 1`. -/
def checkOddExitVacuumCascade (m a b : Nat) : Bool :=
  match affineIter m a b with
  | some (a', d') => decide (d' = 1 ∧ a' % 2 = 1 ∧ a' ≤ 2 * a ∧ b ≥ 1)
  | none => false

/-- TWIERDZENIE O POPRAWNOŚCI KASKADY Z NIEPARZYSTYM WYJŚCIEM (`checkOddExitVacuumCascade_sound`):
    Jeżeli `checkOddExitVacuumCascade m a b = true`, to dla każdej pary `(r, W) ∈ ℕ²`
    liczba `n = a * ((2 * W + 1) * 4^(r + 1)) + b`:
    1. Po `m` krokach trafia na próg doliny próżniowej `(a' * (2 * W + 1)) * 4^(r + 1) + 1`
       z nieparzystym prefiksem `a' * (2 * W + 1)`.
    2. Po kolejnych `3 * r + 4` krokach (łącznie `3 * r + 4 + m` krokach) ulega dodatkowemu
       dzieleniu przez 2 (`v₂ ≥ 3`) i ścisłej kontrakcji poniżej `n`. -/
theorem checkOddExitVacuumCascade_sound (m a b : Nat)
    (h : checkOddExitVacuumCascade m a b = true) (r W : Nat) :
    let n := a * ((2 * W + 1) * 4 ^ (r + 1)) + b
    collatzIter (3 * r + 4 + m) n < n ∧ HasHorizonDrop n := by
  intro n
  unfold checkOddExitVacuumCascade at h
  cases h_iter : affineIter m a b with
  | none =>
    rw [h_iter] at h
    contradiction
  | some p =>
    rcases p with ⟨a', d'⟩
    rw [h_iter] at h
    simp only [decide_eq_true_eq] at h
    rcases h with ⟨hd', ha'_odd, ha'_le, hb⟩
    subst hd'
    have hstep1 : collatzIter m n = a' * ((2 * W + 1) * 4 ^ (r + 1)) + 1 :=
      affineIter_sound m a b a' 1 ((2 * W + 1) * 4 ^ (r + 1)) h_iter
    have hmul_assoc : a' * ((2 * W + 1) * 4 ^ (r + 1)) = (a' * (2 * W + 1)) * 4 ^ (r + 1) := by
      rw [Nat.mul_assoc]
    let U := a' * (2 * W + 1)
    have hU_odd_decomp : U = 2 * (a' * W) + a' := by
      show a' * (2 * W + 1) = 2 * (a' * W) + a'
      rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm a' 2, Nat.mul_assoc]
    have hU_odd : U = 2 * (U / 2) + 1 := by omega
    have hstep1_U : collatzIter m n = (2 * (U / 2) + 1) * 4 ^ (r + 1) + 1 := by
      rw [hstep1, hmul_assoc]
      change U * 4 ^ (r + 1) + 1 = _
      rw [← hU_odd]
    have hcasc : collatzIter (3 * r + 4 + m) n = (3 ^ (r + 1) * U + 1) / 2 := by
      rw [collatzIter_add (3 * r + 4) m n, hstep1_U]
      have h_exit := (zero_valley_odd_exit_cascade r (U / 2)).2.1
      rw [h_exit, ← hU_odd]
    have hpow : 3 ^ (r + 1) ≤ 4 ^ (r + 1) := pow3_le_pow4 (r + 1)
    have hle1 : 3 ^ (r + 1) * U ≤ 4 ^ (r + 1) * U :=
      Nat.mul_le_mul_right U hpow
    have hle2 : U ≤ (2 * a) * (2 * W + 1) :=
      Nat.mul_le_mul_right (2 * W + 1) ha'_le
    have hle3 : 4 ^ (r + 1) * U ≤ 4 ^ (r + 1) * ((2 * a) * (2 * W + 1)) :=
      Nat.mul_le_mul_left (4 ^ (r + 1)) hle2
    have hcomm : 4 ^ (r + 1) * ((2 * a) * (2 * W + 1)) = 2 * (a * ((2 * W + 1) * 4 ^ (r + 1))) := by
      calc 4 ^ (r + 1) * ((2 * a) * (2 * W + 1))
        _ = ((2 * a) * (2 * W + 1)) * 4 ^ (r + 1) := by rw [Nat.mul_comm]
        _ = (2 * a) * ((2 * W + 1) * 4 ^ (r + 1)) := by rw [Nat.mul_assoc]
        _ = 2 * (a * ((2 * W + 1) * 4 ^ (r + 1))) := by rw [Nat.mul_assoc]
    rw [hcomm] at hle3
    have hlt : collatzIter (3 * r + 4 + m) n < n := by
      show collatzIter (3 * r + 4 + m) n < a * ((2 * W + 1) * 4 ^ (r + 1)) + b
      rw [hcasc]
      omega
    have hge1 : collatzIter (3 * r + 4 + m) n ≥ 1 := by
      rw [hcasc]
      have hU_ge1 : 1 ≤ U := by omega
      have hprod_ge1 : 1 * 1 ≤ 3 ^ (r + 1) * U :=
        Nat.mul_le_mul (pow3_pos (r + 1)) hU_ge1
      omega
    exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (3 * r + 4 + m) n (by omega) hge1 hlt⟩

