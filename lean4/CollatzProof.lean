-- CZĘŚĆ 24. WYJŚCIE Z DOLINY PRÓŻNIOWEJ `(2W + 1) * 4^(r+1) + 1` W `3r + 4` KROKACH
--           (`zero_valley_odd_exit_cascade`, REZONANS `v₂ = 3` NA KRAWĘDZI PRÓŻNI)
-- =============================================================================

/-- Każda potęga czwórki `4^k` jest dodatnia (`4^k ≥ 1`): -/
theorem pow4_pos (k : Nat) : 4 ^ k ≥ 1 := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Każda potęga trójki `3^k` jest dodatnia (`1 ≤ 3^k`): -/
theorem pow3_pos (k : Nat) : 1 ≤ 3 ^ k := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Każda potęga trójki `3^k` jest liczbą nieparzystą (`3^k % 2 = 1`): -/
theorem pow3_odd (k : Nat) : (3 ^ k) % 2 = 1 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- TWIERDZENIE O WYJŚCIU Z PRÓŻNI DOLINY ZEROWEJ (`zero_valley_odd_exit_cascade`):
    Dla dowolnej liczby postaci `(2 * W + 1) * 4^(r + 1) + 1` (dolina `2 * r + 2` zer
    zakończona od góry bitem `1`, czyli nieparzystym prefiksem `2 * W + 1`):
    1. Po `3 * r + 3` krokach cała dolina `2 * r + 2` zer ulega kompresji do `3^(r + 1) * (2 * W + 1) + 1`.
    2. Ponieważ iloczyn nieparzystych liczb `3^(r + 1)` oraz `2 * W + 1` jest zawsze nieparzysty,
       stan `3^(r + 1) * (2 * W + 1) + 1` jest ZAWSZE PARZYSTY, więc `(3 * r + 4)`-ty krok Collatza
       wykonuje dodatkowe dzielenie przez 2 (`v₂ ≥ 3`), dając:
         `collatzIter (3 * r + 4) ((2 * W + 1) * 4^(r + 1) + 1) = (3^(r + 1) * (2 * W + 1) + 1) / 2`. -/
theorem zero_valley_odd_exit_cascade (r W : Nat) :
    let n0 := (2 * W + 1) * 4 ^ (r + 1) + 1
    collatzIter (3 * r + 3) n0 = 3 ^ (r + 1) * (2 * W + 1) + 1 ∧
    collatzIter (3 * r + 4) n0 = (3 ^ (r + 1) * (2 * W + 1) + 1) / 2 ∧
    collatzIter (3 * r + 4) n0 < n0 ∧
    HasHorizonDrop n0 := by
  intro n0
  have hvac : collatzIter (3 * r + 3) n0 = 3 ^ (r + 1) * (2 * W + 1) + 1 := by
    show collatzIter (3 * (r + 1)) ((2 * W + 1) * 4 ^ (r + 1) + 1) = _
    exact zero_valley_vacuum_inductive (r + 1) (2 * W + 1)
  have hodd3 : (3 ^ (r + 1)) % 2 = 1 := pow3_odd (r + 1)
  have hprod : 3 ^ (r + 1) * (2 * W + 1) = 2 * (3 ^ (r + 1) * W) + 3 ^ (r + 1) := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (3 ^ (r + 1)) 2, Nat.mul_assoc]
  have heven : (3 ^ (r + 1) * (2 * W + 1) + 1) % 2 = 0 := by omega
  have hstep4 : collatzIter (3 * r + 4) n0 = (3 ^ (r + 1) * (2 * W + 1) + 1) / 2 := by
    have hsucc : collatzIter (3 * r + 4) n0 = collatzStep (collatzIter (3 * r + 3) n0) :=
      collatzIter_succ_right (3 * r + 3) n0
    rw [hsucc, hvac]
    unfold collatzStep
    simp [heven]
  have hpow : 3 ^ (r + 1) ≤ 4 ^ (r + 1) := pow3_le_pow4 (r + 1)
  have hmul : 3 ^ (r + 1) * (2 * W + 1) ≤ 4 ^ (r + 1) * (2 * W + 1) :=
    Nat.mul_le_mul_right (2 * W + 1) hpow
  have hcomm : (2 * W + 1) * 4 ^ (r + 1) = 4 ^ (r + 1) * (2 * W + 1) :=
    Nat.mul_comm (2 * W + 1) (4 ^ (r + 1))
  have hn0_eq : n0 = 4 ^ (r + 1) * (2 * W + 1) + 1 := by
    show (2 * W + 1) * 4 ^ (r + 1) + 1 = _
    rw [hcomm]
  have hlt : collatzIter (3 * r + 4) n0 < n0 := by
    rw [hstep4, hn0_eq]
    omega
  have hge1 : collatzIter (3 * r + 4) n0 ≥ 1 := by
    rw [hstep4]
    omega
  refine ⟨hvac, hstep4, hlt, hasHorizonDrop_of_ge_one_and_lt (3 * r + 4) n0 (by omega) hge1 hlt⟩

