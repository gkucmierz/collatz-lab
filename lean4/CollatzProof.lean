--           I `collatzIter (2r + 4)` NA SUFIKSIE MERSENNE'A ORAZ POZIOM `k = 27` (`98.6870%`)
-- =============================================================================

/-- Dla dowolnej liczby `x ≡ 3 (mod 4)` dokładnie dwa klasyczne kroki Collatza (`collatzIter 2 x`)
    pokrywają się z pojedynczym krokiem operatora Syracuse `syracuseV1 x = (3 * x + 1) / 2`. -/
theorem collatzIter2_eq_syracuseV1 (x : Nat) (hx : x % 4 = 3) :
    collatzIter 2 x = syracuseV1 x := by
  have hs0 : collatzIter 2 x = collatzStep (collatzStep x) := rfl
  have hs1 : collatzStep x = 3 * x + 1 := by
    unfold collatzStep
    have hodd : x % 2 = 1 := by omega
    simp [hodd]
  have hs2 : collatzStep (3 * x + 1) = (3 * x + 1) / 2 := by
    unfold collatzStep
    have heven : (3 * x + 1) % 2 = 0 := by omega
    simp [heven]
  rw [hs0, hs1, hs2]
  rfl

/-- Każdy ogon Mersenne'a `mersenneTail M (k + 1)` o długości `k + 1 ≥ 2` (`k ≥ 1`)
    spełnia `mersenneTail M (k + 1) ≡ 3 (mod 4)`. -/
theorem mersenneTail_mod4_eq_3 (M k : Nat) (hk : k ≥ 1) :
    (mersenneTail M (k + 1)) % 4 = 3 := by
  cases k with
  | zero => omega
  | succ m =>
    unfold mersenneTail
    have hp1 : 2 ^ (m + 1 + 1) = 4 * 2 ^ m := by
      show 2 ^ (m + 2) = 4 * 2 ^ m
      rw [Nat.pow_succ, Nat.pow_succ]
      omega
    have hp2 : 2 ^ (m + 1 + 1 + 1) = 8 * 2 ^ m := by
      show 2 ^ (m + 3) = 8 * 2 ^ m
      rw [Nat.pow_succ, Nat.pow_succ, Nat.pow_succ]
      omega
    have hm1 : M * 2 ^ (m + 1 + 1 + 1) = 8 * (M * 2 ^ m) := by
      rw [hp2, ← Nat.mul_assoc, Nat.mul_comm M 8, Nat.mul_assoc]
    have hpos : 2 ^ m ≥ 1 := Nat.one_le_two_pow
    omega

/-- Równoważność `2 * r` klasycznych kroków Collatza (`collatzIter (2 * r)`) oraz `r` kroków
    operatora `syracuseV1Iter r` w trakcie wyczerpywania sufiksu Mersenne'a o długości `r + d + 1`. -/
theorem collatzIter_eq_syracuseV1Iter_mersenneTail (r M d : Nat) :
    collatzIter (2 * r) (mersenneTail M (r + d + 1)) =
      syracuseV1Iter r (mersenneTail M (r + d + 1)) := by
  induction r generalizing M d with
  | zero =>
    rfl
  | succ r ih =>
    have hmul : 2 * (r + 1) = 2 * r + 2 := by omega
    rw [hmul, collatzIter_add (2 * r) 2]
    have h_arith : r + 1 + d + 1 = (r + d + 1) + 1 := by omega
    have h_ge1 : r + d + 1 ≥ 1 := by omega
    have hmod4 : (mersenneTail M (r + 1 + d + 1)) % 4 = 3 := by
      rw [h_arith]
      exact mersenneTail_mod4_eq_3 M (r + d + 1) h_ge1
    rw [collatzIter2_eq_syracuseV1 _ hmod4]
    simp only [syracuseV1Iter]
    rw [h_arith, lemma2_step_mersenneTail M (r + d + 1) h_ge1]
    exact ih (3 * M + 1) d

/-- ZUNIFIKOWANE TWIERDZENIE O PEŁNEJ KASKADZIE RLE W KLASYCZNYM AUTOMACIE COLLATZA
    (`collatzIter_two_block_rle_cascade`):
    Dla dowolnego `r ≥ 0` i dowolnego prefiksu `M ≥ 0`, startując z liczby
    `mersenneTail M (r + 1) = M * 2^(r + 2) + (2^(r + 1) - 1)`:
    1. Po dokładnie `2 * r + 3` klasycznych krokach Collatza trajektoria osiąga
       `3 * (mersennePrefixIter r M) + 1`.
    2. W gałęzi nieparzystego rezonansu `(M + r) % 2 = 1` (tunelowanie `v₂ ≥ 3`),
       po dokładnie `2 * r + 4` klasycznych krokach Collatza trajektoria osiąga
       `(3 * (mersennePrefixIter r M) + 1) / 2`. -/
theorem collatzIter_two_block_rle_cascade (r M : Nat) :
    let M' := mersennePrefixIter r M
    collatzIter (2 * r + 3) (mersenneTail M (r + 1)) = 3 * M' + 1 ∧
    ((M + r) % 2 = 1 →
      collatzIter (2 * r + 4) (mersenneTail M (r + 1)) = (3 * M' + 1) / 2) := by
  intro M'
  have hexh : collatzIter (2 * r) (mersenneTail M (r + 1)) = mersenneTail M' 1 := by
    have h0 : r + 1 = r + 0 + 1 := by omega
    rw [h0, collatzIter_eq_syracuseV1Iter_mersenneTail r M 0,
        deterministic_k1_run_exhaustion r M 0]
  constructor
  · have hadd3 : 2 * r + 3 = 3 + 2 * r := by omega
    rw [hadd3, collatzIter_add 3 (2 * r), hexh]
    exact (mersenne_exhaustion_step3_drop M').1
  · intro hodd_res
    have hadd4 : 2 * r + 4 = 4 + 2 * r := by omega
    rw [hadd4, collatzIter_add 4 (2 * r), hexh]
    have hpar : M' % 2 = (M + r) % 2 := mersennePrefixIter_parity r M
    have hodd : M' % 2 = 1 := by omega
    exact (mersenne_exhaustion_step4_odd_tunneling M' hodd).1

