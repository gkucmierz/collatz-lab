-- CZĘŚĆ 21. LINIOWOŚĆ AFINICZNA `mersennePrefixIter_affine_linear`
--           ORAZ RÓWNANIE TUNELOWANIA PRZEZ WIELOZERO `collatzIter_multi_zero_valley_mersenne`
-- =============================================================================

/-- Liniowość afiniczna operatora prefiksu Mersenne'a (`mersennePrefixIter_affine_linear`):
    Dla każdego `r ≥ 0` i dowolnego prefiksu `M ≥ 0`:
      `mersennePrefixIter r M = 3^r * M + mersennePrefixIter r 0`. -/
theorem mersennePrefixIter_affine_linear (r M : Nat) :
    mersennePrefixIter r M = 3 ^ r * M + mersennePrefixIter r 0 := by
  have hM : 2 * (mersennePrefixIter r M) + 1 = 3 ^ r * (2 * M + 1) :=
    mersennePrefixIter_closed_form r M
  have h0 : 2 * (mersennePrefixIter r 0) + 1 = 3 ^ r * (2 * 0 + 1) :=
    mersennePrefixIter_closed_form r 0
  have hdist : 3 ^ r * (2 * M + 1) = 2 * (3 ^ r * M) + 3 ^ r * 1 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (3 ^ r) 2, Nat.mul_assoc]
  omega

/-- TWIERDZENIE O TUNELOWANIU SUFIKSU MERSENNE'A POD DOLINĄ WIELOZERA
    (`collatzIter_multi_zero_valley_mersenne`):
    Dla liczby `mersenneTail (Q * 2^z) (r + 1)` posiadającej dolinę `z + 1` zer nad blokiem `1^(r+1)₂`:
    po `2 * r + 3` klasycznych krokach Collatza górny prefiks `Q` ulega czystemu przemnożeniu
    przez `3^(r + 1)` na pozycji `2^z`, a dolina zer wypełnia się kanoniczną stałą `mersennePrefixIter (r + 1) 0`:
      `collatzIter (2 * r + 3) (mersenneTail (Q * 2^z) (r + 1)) = (Q * 3^(r + 1)) * 2^z + mersennePrefixIter (r + 1) 0`. -/
theorem collatzIter_multi_zero_valley_mersenne (r Q z : Nat) :
    collatzIter (2 * r + 3) (mersenneTail (Q * 2 ^ z) (r + 1)) =
      (Q * 3 ^ (r + 1)) * 2 ^ z + mersennePrefixIter (r + 1) 0 := by
  rw [(collatzIter_mersenneTail_eq_mersennePrefixIter r (Q * 2 ^ z)).1]
  rw [mersennePrefixIter_affine_linear (r + 1) (Q * 2 ^ z)]
  have hcomm : 3 ^ (r + 1) * (Q * 2 ^ z) = (Q * 3 ^ (r + 1)) * 2 ^ z := by
    rw [← Nat.mul_assoc, Nat.mul_comm (3 ^ (r + 1)) Q]
  rw [hcomm]

