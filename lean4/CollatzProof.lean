/-- TWIERDZENIE O REZONANSIE `mod 16` (`v₂ ≥ 4`) KASKADY RLE `-13` (`...10011₂`) W `5r + 15` KROKACH:
    Ponieważ `(9^(r + 2)) % 16 = 1 + 8 * ((r + 2) % 2)`, dla prefiksu
    `U = 16 * W + 7 + 8 * ((r + 2) % 2)` licznik `9^(r + 2) * U - 7` dzieli się przez `16`,
    dając po `5r + 15` krokach dokładnie `(9^(r + 2) * U - 7) / 16`: -/
theorem rle_10011_mod16_resonance_step15 (r W : Nat) :
    let U := 16 * W + 7 + 8 * ((r + 2) % 2)
    collatzIter (5 * r + 15) (U * 2 ^ (3 * r + 7) - 13) =
      (9 ^ (r + 2) * U - 7) / 16 := by
  intro U
  have h15 : 5 * r + 15 = 3 + (5 * r + 12) := by omega
  have hU : U = 2 * (8 * W + 3 + 4 * ((r + 2) % 2)) + 1 := by omega
  rw [h15, collatzIter_add 3 (5 * r + 12), hU, rle_10011_odd_prefix_step12_exit r (8 * W + 3 + 4 * ((r + 2) % 2)), ← hU]
  have h9_mod16 : (9 ^ (r + 2)) % 16 = 1 + 8 * ((r + 2) % 2) := pow9_mod16 (r + 2)
  have h9_ge9 : 9 ≤ 9 ^ (r + 2) := by
    rw [Nat.pow_succ]
    have := pow9_pos (r + 1)
    omega
  have hdecomp : 9 ^ (r + 2) * U = 16 * (9 ^ (r + 2) * W) + (7 + 8 * ((r + 2) % 2)) * 9 ^ (r + 2) := by
    show 9 ^ (r + 2) * (16 * W + 7 + 8 * ((r + 2) % 2)) = _
    have hU2 : 16 * W + 7 + 8 * ((r + 2) % 2) = 16 * W + (7 + 8 * ((r + 2) % 2)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 2)) 16, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 2)) (7 + 8 * ((r + 2) % 2))]
  have hp : (r + 2) % 2 = 0 ∨ (r + 2) % 2 = 1 := by omega
  have hdiv16 : (9 ^ (r + 2) * U - 7) % 16 = 0 := by
    rcases hp with h0 | h1
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
  exact div2_step3_eq_div16 (9 ^ (r + 2) * U - 7) hdiv16

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 16` KASKADY RLE `-13` (`r = 0..27`, aż do `2^88`!): -/
theorem rle_10011_mod16_contraction (r W : Nat)
    (hr : 9 ^ (r + 2) + 32 ≤ 16 * 2 ^ (3 * r + 7)) :
    let U := 16 * W + 7 + 8 * ((r + 2) % 2)
    let n0 := U * 2 ^ (3 * r + 7) - 13
    collatzIter (5 * r + 15) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro U n0
  have hcasc : collatzIter (5 * r + 15) n0 = (9 ^ (r + 2) * U - 7) / 16 :=
    rle_10011_mod16_resonance_step15 r W
  have hle : (9 ^ (r + 2) + 32) * U ≤ (16 * 2 ^ (3 * r + 7)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 16 (2 ^ (3 * r + 7)) U, Nat.mul_comm (2 ^ (3 * r + 7)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 2) := by
    rw [Nat.pow_succ]
    have := pow9_pos (r + 1)
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 2) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge7 : U ≥ 7 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 7) - 13 := rfl
  have hlt : collatzIter (5 * r + 15) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 15) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 15) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O REZONANSIE `mod 16` (`v₂ ≥ 4`) KASKADY RLE `-9` (`...10111₂`) W `5r + 17` KROKACH:
