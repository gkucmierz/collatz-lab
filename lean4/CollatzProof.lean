--           (`shifted_valley_d1` DO `2^184`, `two_zero_valley_d5` DO `2^203`, `two_zero_valley_d4`
--           DO `2^157`, `shifted_valley_d2` DO `2^146`), SPRZĘŻENIE MIĘDZYRODZINOWE (`-7 ↔ -5`)
