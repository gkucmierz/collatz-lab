      rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm A 8192, Nat.mul_assoc]
      omega
    have h3 : (M % 8192) = (b % 8192) := by omega
    rw [hcomm, Nat.mul_mod, h2, h3, ← Nat.mul_mod]
  omega

