-- CZĘŚĆ 46. 2-ADYCZNA OKRESOWOŚĆ POTĘG DZIEWIĄTKI `mod 256` (`pow9_mod256`),
--           REZONANS `v₂ ≥ 8` (`5r + 13` KROKÓW) DO `r = 46` (`2^141`!) ORAZ `k = 134..142`
-- =============================================================================

/-- Twierdzenie o 2-adycznej okresowości potęg dziewiątki modulo 256 (okres 32):
    Dla każdego `k ∈ ℕ` zachodzi:
      `(9^k) % 256 = 1 + 8 * ((k + 8 * (k / 2) + 16 * (k / 4) + 16 * ((k + 1) / 4)) % 32)`. -/
theorem pow9_mod256 (k : Nat) :
    (9 ^ k) % 256 = 1 + 8 * ((k + 8 * (k / 2) + 16 * (k / 4) + 16 * ((k + 1) / 4)) % 32) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ, Nat.mul_mod, ih]
    have hp : k % 4 = 0 ∨ k % 4 = 1 ∨ k % 4 = 2 ∨ k % 4 = 3 := by omega
    rcases hp with h0 | h1 | h2 | h3 <;> omega

/-- Lemat o 7 krokach parzystych przy podzielności przez 256 (`v₂ ≥ 8`): -/
theorem div2_step7_eq_div256 (N : Nat) (hN : N % 256 = 0) :
    collatzIter 7 (N / 2) = N / 256 := by
  have s1 : collatzStep (N / 2)   = N / 4   := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (N / 4)   = N / 8   := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (N / 8)   = N / 16  := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (N / 16)  = N / 32  := by unfold collatzStep; split <;> omega
  have s5 : collatzStep (N / 32)  = N / 64  := by unfold collatzStep; split <;> omega
  have s6 : collatzStep (N / 64)  = N / 128 := by unfold collatzStep; split <;> omega
  have s7 : collatzStep (N / 128) = N / 256 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (N / 2))))))) = N / 256
  rw [s1, s2, s3, s4, s5, s6, s7]

set_option maxHeartbeats 800000 in
/-- TWIERDZENIE O REZONANSIE `mod 256` (`v₂ ≥ 8`) DLA MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 13` KROKACH:
    Ponieważ `(1 + 8s)(7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)) ≡ 7 (mod 256)` dla każdego `s ∈ {0..31}`,
    dla `s = (r + 1 + 8 * ((r + 1) / 2) + 16 * ((r + 1) / 4) + 16 * ((r + 2) / 4)) % 32`
    oraz prefiksu `U = 256 * W + 7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)`
    licznik `9^(r + 1) * U - 7` dzieli się przez `256`, dając po `5r + 13` krokach:
      `collatzIter (5 * r + 13) (U * 2^(3 * r + 3) - 7) = (9^(r + 1) * U - 7) / 256`. -/
theorem two_zero_valley_mod256_resonance_step13 (r W : Nat) :
    let s := (r + 1 + 8 * ((r + 1) / 2) + 16 * ((r + 1) / 4) + 16 * ((r + 2) / 4)) % 32
    let U := 256 * W + 7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)
    collatzIter (5 * r + 13) (U * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * U - 7) / 256 := by
  intro s U
  have h13 : 5 * r + 13 = 7 + (5 * r + 6) := by omega
  have hU : U = 2 * (128 * W + 3 + 4 * ((s + 16 * ((s + 1) / 2)) % 32)) + 1 := by omega
  rw [h13, collatzIter_add 7 (5 * r + 6), hU, two_zero_valley_odd_prefix_step6_exit r (128 * W + 3 + 4 * ((s + 16 * ((s + 1) / 2)) % 32)), ← hU]
  have h9_mod256 : (9 ^ (r + 1)) % 256 = 1 + 8 * s := by
    have h2 : r + 1 + 1 = r + 2 := by omega
    have h := pow9_mod256 (r + 1)
    rw [h2] at h
    exact h
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * U = 256 * (9 ^ (r + 1) * W) + (7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (256 * W + 7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)) = _
    have hU2 : 256 * W + 7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32) = 256 * W + (7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 256, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (7 + 8 * ((s + 16 * ((s + 1) / 2)) % 32))]
