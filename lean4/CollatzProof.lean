-- CZĘŚĆ 29. PRAWO REZONANSU `9^(r+1) ≡ 1 (mod 8)` (`v₂ ≥ 3` PO MAKRO-EROZJI `-7` I `-5`)
--           ORAZ BEZWARUNKOWA KONTRAKCJA W `5r + 8` KROKACH DLA `r = 0..16` (DO `2^51`)
-- =============================================================================

/-- Każda potęga dziewiątki przystaje do `1 (mod 8)` (`9^k % 8 = 1`): -/
theorem pow9_mod8_eq1 (k : Nat) : (9 ^ k) % 8 = 1 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Jeżeli `N % 8 = 0`, to z `N / 2` dwa kolejne kroki Collatza wykonują dwa dzielenia przez 2,
    dając `N / 8`: -/
theorem div2_step2_eq_div8 (N : Nat) (hN : N % 8 = 0) :
    collatzIter 2 (N / 2) = N / 8 := by
  have s1 : collatzStep (N / 2) = N / 4 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (N / 4) = N / 8 := by unfold collatzStep; split <;> omega
  simp [collatzIter, s1, s2]

/-- TWIERDZENIE O REZONANSIE `mod 8` DLA MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 8` KROKACH:
    Ponieważ `9^(r + 1) ≡ 1 (mod 8)` dla każdego `r ∈ ℕ`, dla każdego prefiksu `2M + 1 = 8W + 7`
    (`M = 4W + 3`) licznik `9^(r + 1) * (8W + 7) - 7` jest podzielny przez `8`, więc po `5r + 8`
    krokach zachodzi dokładna tożsamość:
      `collatzIter (5 * r + 8) ((8 * W + 7) * 2^(3 * r + 3) - 7) = (9^(r + 1) * (8 * W + 7) - 7) / 8`. -/
theorem two_zero_valley_mod8_resonance_step8 (r W : Nat) :
    collatzIter (5 * r + 8) ((8 * W + 7) * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * (8 * W + 7) - 7) / 8 := by
  have h8 : 5 * r + 8 = 2 + (5 * r + 6) := by omega
  have hU : 8 * W + 7 = 2 * (4 * W + 3) + 1 := by omega
  rw [h8, collatzIter_add 2 (5 * r + 6), hU]
  rw [two_zero_valley_odd_prefix_step6_exit r (4 * W + 3)]
  rw [← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have hdecomp : 9 ^ (r + 1) * (8 * W + 7) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 7 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
  have hdiv8 : (9 ^ (r + 1) * (8 * W + 7) - 7) % 8 = 0 := by omega
  exact div2_step2_eq_div8 (9 ^ (r + 1) * (8 * W + 7) - 7) hdiv8

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 8` RODZINY `-7` (`r = 0..16`):
    Dla każdego `r ∈ ℕ` spełniającego `9^(r + 1) + 8 ≤ 8 * 2^(3 * r + 3)` (co zachodzi dla
    wszystkich `r ∈ {0, 1, ..., 16}`, czyli bloków jedynek aż do 54 bitów!) oraz każdego `W ∈ ℕ`:
      `collatzIter (5 * r + 8) ((8 * W + 7) * 2^(3 * r + 3) - 7) < (8 * W + 7) * 2^(3 * r + 3) - 7`. -/
theorem two_zero_valley_mod8_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 8 ≤ 8 * 2 ^ (3 * r + 3)) :
    let n0 := (8 * W + 7) * 2 ^ (3 * r + 3) - 7
    collatzIter (5 * r + 8) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := two_zero_valley_mod8_resonance_step8 r W
  let U := 8 * W + 7
  have hle : (9 ^ (r + 1) + 8) * U ≤ (8 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 1) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge7 : U ≥ 7 := by omega
  have hlt : collatzIter (5 * r + 8) n0 < n0 := by
    show collatzIter (5 * r + 8) ((8 * W + 7) * 2 ^ (3 * r + 3) - 7) < U * 2 ^ (3 * r + 3) - 7
    rw [hcasc]
    change (9 ^ (r + 1) * U - 7) / 8 < U * 2 ^ (3 * r + 3) - 7
    omega
  have hge1 : collatzIter (5 * r + 8) n0 ≥ 1 := by
    show collatzIter (5 * r + 8) ((8 * W + 7) * 2 ^ (3 * r + 3) - 7) ≥ 1
    rw [hcasc]
    change (9 ^ (r + 1) * U - 7) / 8 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 8) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O REZONANSIE `mod 8` DLA MAKRO-EROZJI PRZESUNIĘTEJ (`-5`) W `5r + 8` KROKACH:
    Dla każdego `r ∈ ℕ` oraz każdego `W ∈ ℕ` (`2M + 1 = 8W + 5`, `M = 4W + 2`):
      `collatzIter (5 * r + 8) ((8 * W + 5) * 2^(3 * r + 3) - 5) = (9^(r + 1) * (8 * W + 5) - 5) / 8`. -/
theorem shifted_valley_mod8_resonance_step8 (r W : Nat) :
    collatzIter (5 * r + 8) ((8 * W + 5) * 2 ^ (3 * r + 3) - 5) =
      (9 ^ (r + 1) * (8 * W + 5) - 5) / 8 := by
  have h8 : 5 * r + 8 = 2 + (5 * r + 6) := by omega
  have hU : 8 * W + 5 = 2 * (4 * W + 2) + 1 := by omega
  rw [h8, collatzIter_add 2 (5 * r + 6), hU]
  rw [shifted_valley_odd_prefix_step6_exit r (4 * W + 2) (by omega)]
  rw [← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have hdecomp : 9 ^ (r + 1) * (8 * W + 5) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 5 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
  have hdiv8 : (9 ^ (r + 1) * (8 * W + 5) - 5) % 8 = 0 := by omega
  exact div2_step2_eq_div8 (9 ^ (r + 1) * (8 * W + 5) - 5) hdiv8

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 8` RODZINY `-5` (`r = 0..16`):
    Dla każdego `r ∈ ℕ` spełniającego `9^(r + 1) + 8 ≤ 8 * 2^(3 * r + 3)` oraz każdego `W ∈ ℕ`:
      `collatzIter (5 * r + 8) ((8 * W + 5) * 2^(3 * r + 3) - 5) < (8 * W + 5) * 2^(3 * r + 3) - 5`. -/
theorem shifted_valley_mod8_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 8 ≤ 8 * 2 ^ (3 * r + 3)) :
    let n0 := (8 * W + 5) * 2 ^ (3 * r + 3) - 5
    collatzIter (5 * r + 8) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := shifted_valley_mod8_resonance_step8 r W
  let U := 8 * W + 5
  have hle : (9 ^ (r + 1) + 8) * U ≤ (8 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 1) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge5 : U ≥ 5 := by omega
  have hlt : collatzIter (5 * r + 8) n0 < n0 := by
    show collatzIter (5 * r + 8) ((8 * W + 5) * 2 ^ (3 * r + 3) - 5) < U * 2 ^ (3 * r + 3) - 5
    rw [hcasc]
    change (9 ^ (r + 1) * U - 5) / 8 < U * 2 ^ (3 * r + 3) - 5
    omega
  have hge1 : collatzIter (5 * r + 8) n0 ≥ 1 := by
    show collatzIter (5 * r + 8) ((8 * W + 5) * 2 ^ (3 * r + 3) - 5) ≥ 1
    rw [hcasc]
    change (9 ^ (r + 1) * U - 5) / 8 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 8) n0 (by omega) hge1 hlt⟩

