-- CZĘŚĆ 28. SYMETRYCZNE WYJŚCIE Z MAKRO-EROZJI PRZESUNIĘTEJ (`-5`) W `5r + 6` KROKACH
--           ORAZ GŁĘBOKIE POZIOMY 2-ADYCZNE `k = 31` (`2^31`), `k = 32` (`2^32`), `k = 34` (`2^34`)
-- =============================================================================

/-- Dla dowolnego `B ≥ 1` (zarówno parzystego, jak i nieparzystego) liczba `B * 8 - 5`
    po dokładnie 5 krokach Collatza przechodzi w `9 * B - 5`: -/
theorem shifted_valley_step5_all (B : Nat) (hB : B ≥ 1) :
    collatzIter 5 (B * 8 - 5) = 9 * B - 5 := by
  have s1 : collatzStep (B * 8 - 5) = 24 * B - 14 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (24 * B - 14) = 12 * B - 7 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (12 * B - 7) = 36 * B - 20 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (36 * B - 20) = 18 * B - 10 := by unfold collatzStep; split <;> omega
  have s5 : collatzStep (18 * B - 10) = 9 * B - 5 := by unfold collatzStep; split <;> omega
  simp [collatzIter, s1, s2, s3, s4, s5]

/-- TWIERDZENIE O UNIWERSALNYM WYJŚCIU Z MAKRO-EROZJI PRZESUNIĘTEJ W `5r + 5` KROKACH:
    Dla dowolnego `r ∈ ℕ` oraz `A ≥ 1`:
      `collatzIter (5 * r + 5) (A * 2^(3 * r + 3) - 5) = 9^(r + 1) * A - 5`. -/
theorem shifted_valley_universal_step5_exit (r A : Nat) (hA : A ≥ 1) :
    collatzIter (5 * r + 5) (A * 2 ^ (3 * r + 3) - 5) = 9 ^ (r + 1) * A - 5 := by
  rw [Nat.add_comm (5 * r) 5, collatzIter_add 5 (5 * r)]
  have hm := shifted_valley_macro_erosion r A 3 hA (by decide)
  rw [hm]
  have hB : 1 * 1 ≤ 9 ^ r * A := Nat.mul_le_mul (pow9_pos r) hA
  rw [shifted_valley_step5_all (9 ^ r * A) (by omega)]
  have hpow9 : 9 ^ (r + 1) * A = 9 * (9 ^ r * A) := by
    rw [Nat.pow_succ, Nat.mul_comm (9 ^ r) 9, Nat.mul_assoc]
  rw [hpow9]

/-- TWIERDZENIE O SYMETRYCZNYM WYJŚCIU Z MAKRO-EROZJI PRZESUNIĘTEJ W `5r + 6` KROKACH:
    Gdy blok jedynek nad sufiksem `011₂` (`-5`) jest zakończony od góry przynajmniej jednym
    zerem (`A = 2 * M + 1`, `M ≥ 1`), stan `9^(r + 1) * (2 * M + 1) - 5` w kroku `5 * r + 5`
    jest ZAWSZE PARZYSTY, więc w kroku `5 * r + 6` ulega dzieleniu przez 2:
      `collatzIter (5 * r + 6) ((2 * M + 1) * 2^(3 * r + 3) - 5) = (9^(r + 1) * (2 * M + 1) - 5) / 2`. -/
theorem shifted_valley_odd_prefix_step6_exit (r M : Nat) (hM : M ≥ 1) :
    collatzIter (5 * r + 6) ((2 * M + 1) * 2 ^ (3 * r + 3) - 5) =
      (9 ^ (r + 1) * (2 * M + 1) - 5) / 2 := by
  have hsucc : collatzIter (5 * r + 6) ((2 * M + 1) * 2 ^ (3 * r + 3) - 5) =
      collatzStep (collatzIter (5 * r + 5) ((2 * M + 1) * 2 ^ (3 * r + 3) - 5)) :=
    collatzIter_succ_right (5 * r + 5) ((2 * M + 1) * 2 ^ (3 * r + 3) - 5)
  rw [hsucc, shifted_valley_universal_step5_exit r (2 * M + 1) (by omega)]
  have h9_odd : (9 ^ (r + 1)) % 2 = 1 := pow9_odd (r + 1)
  have hB_decomp : 9 ^ (r + 1) * (2 * M + 1) = 2 * (9 ^ (r + 1) * M) + 9 ^ (r + 1) := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 2, Nat.mul_assoc]
  have heven : (9 ^ (r + 1) * (2 * M + 1) - 5) % 2 = 0 := by omega
  unfold collatzStep
  simp [heven]

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI RODZINY PRZESUNIĘTEJ (`-5`) DLA `r ∈ {0, 1, 2, 3, 4}`:
    Każda liczba postaci `(2 * M + 1) * 2^(3 * r + 3) - 5` (dla `M ≥ 1` oraz `r ∈ {0, 1, 2, 3, 4}`)
    ulega ścisłej kontrakcji wysokości w `5 * r + 6` krokach! -/
theorem shifted_valley_universal_contraction_r0_to_r4 (M : Nat) (hM : M ≥ 1) :
    (collatzIter 6  ((2 * M + 1) * 8     - 5) < (2 * M + 1) * 8     - 5 ∧ HasHorizonDrop ((2 * M + 1) * 8     - 5)) ∧
    (collatzIter 11 ((2 * M + 1) * 64    - 5) < (2 * M + 1) * 64    - 5 ∧ HasHorizonDrop ((2 * M + 1) * 64    - 5)) ∧
    (collatzIter 16 ((2 * M + 1) * 512   - 5) < (2 * M + 1) * 512   - 5 ∧ HasHorizonDrop ((2 * M + 1) * 512   - 5)) ∧
    (collatzIter 21 ((2 * M + 1) * 4096  - 5) < (2 * M + 1) * 4096  - 5 ∧ HasHorizonDrop ((2 * M + 1) * 4096  - 5)) ∧
    (collatzIter 26 ((2 * M + 1) * 32768 - 5) < (2 * M + 1) * 32768 - 5 ∧ HasHorizonDrop ((2 * M + 1) * 32768 - 5)) := by
  have e0 := shifted_valley_odd_prefix_step6_exit 0 M hM
  change collatzIter 6  ((2 * M + 1) * 8     - 5) = (9     * (2 * M + 1) - 5) / 2 at e0
  have e1 := shifted_valley_odd_prefix_step6_exit 1 M hM
  change collatzIter 11 ((2 * M + 1) * 64    - 5) = (81    * (2 * M + 1) - 5) / 2 at e1
  have e2 := shifted_valley_odd_prefix_step6_exit 2 M hM
  change collatzIter 16 ((2 * M + 1) * 512   - 5) = (729   * (2 * M + 1) - 5) / 2 at e2
  have e3 := shifted_valley_odd_prefix_step6_exit 3 M hM
  change collatzIter 21 ((2 * M + 1) * 4096  - 5) = (6561  * (2 * M + 1) - 5) / 2 at e3
  have e4 := shifted_valley_odd_prefix_step6_exit 4 M hM
  change collatzIter 26 ((2 * M + 1) * 32768 - 5) = (59049 * (2 * M + 1) - 5) / 2 at e4
  refine ⟨⟨by omega, hasHorizonDrop_of_ge_one_and_lt 6  _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 11 _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 16 _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 21 _ (by decide) (by omega) (by omega)⟩,
          ⟨by omega, hasHorizonDrop_of_ge_one_and_lt 26 _ (by decide) (by omega) (by omega)⟩⟩

/-- Głębokie domknięcia horyzontowe na poziomach:
