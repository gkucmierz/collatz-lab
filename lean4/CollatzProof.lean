/-- Dla każdego nieparzystego `B ≥ 3` (`B % 2 = 1`) stan `B * 2 - 5` (`d = 1` rodziny `-5`)
    w 3 krokach Collatza osiąga `(3 * B - 7) / 2`: -/
theorem shifted_valley_d1_step3_div2 (B : Nat) (hB : B % 2 = 1) (hB3 : B ≥ 3) :
    collatzIter 3 (B * 2 - 5) = (3 * B - 7) / 2 := by
  have s1 : collatzStep (B * 2 - 5) = 6 * B - 14 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (6 * B - 14) = 3 * B - 7 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (3 * B - 7) = (3 * B - 7) / 2 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (B * 2 - 5))) = (3 * B - 7) / 2
  rw [s1, s2, s3]

/-- TWIERDZENIE O WYJŚCIU Z FAZY `d = 1` (`3r + 1`) MAKRO-EROZJI `-5` W `5r + 3` KROKACH:
    Dla dowolnych `r, M ∈ ℕ` spełniających `r + M ≥ 1` (tak aby `(2 * M + 1) * 2^(3 * r + 1) - 5 > 1`):
      `collatzIter (5 * r + 3) ((2 * M + 1) * 2^(3 * r + 1) - 5) = (3 * 9^r * (2 * M + 1) - 7) / 2`. -/
theorem shifted_valley_d1_odd_prefix_step3_exit (r M : Nat) (hM : r + M ≥ 1) :
    collatzIter (5 * r + 3) ((2 * M + 1) * 2 ^ (3 * r + 1) - 5) =
      (3 * 9 ^ r * (2 * M + 1) - 7) / 2 := by
  have h3 : 5 * r + 3 = 3 + 5 * r := by omega
  rw [h3, collatzIter_add 3 (5 * r)]
  rw [shifted_valley_macro_erosion r (2 * M + 1) 1 (by omega) (by decide)]
  have h9_odd : (9 ^ r) % 2 = 1 := pow9_odd r
  have hB_decomp : 9 ^ r * (2 * M + 1) = 2 * (9 ^ r * M) + 9 ^ r := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (9 ^ r) 2, Nat.mul_assoc]
  have hB_odd : (9 ^ r * (2 * M + 1)) % 2 = 1 := by omega
  have hB_ge3 : 9 ^ r * (2 * M + 1) ≥ 3 := by
    cases r with
    | zero =>
      have : M ≥ 1 := by omega
      have : 9 ^ 0 * (2 * M + 1) = 2 * M + 1 := by omega
      omega
    | succ r' =>
      have h9 : 9 ≤ 9 ^ (r' + 1) := by
        rw [Nat.pow_succ]
        have := pow9_pos r'
        omega
      have := Nat.mul_le_mul h9 (by omega : 1 ≤ 2 * M + 1)
      omega
  have hpow1 : (9 ^ r * (2 * M + 1)) * 2 ^ 1 - 5 = (9 ^ r * (2 * M + 1)) * 2 - 5 := rfl
  rw [hpow1, shifted_valley_d1_step3_div2 (9 ^ r * (2 * M + 1)) hB_odd hB_ge3]
  rw [Nat.mul_assoc 3 (9 ^ r) (2 * M + 1)]

/-- TWIERDZENIE O REZONANSIE `mod 8` (`v₂ ≥ 3`) FAZY `d = 1` RODZINY `-5` W `5r + 5` KROKACH:
    Ponieważ `3 * 5 = 15 ≡ 7 (mod 8)`, dla prefiksu `8 * W + 5` (`M = 4 * W + 2 ≥ 2`)
    licznik `3 * 9^r * (8 * W + 5) - 7` dzieli się przez `8`, dając w `5r + 5` krokach:
      `collatzIter (5 * r + 5) ((8 * W + 5) * 2^(3 * r + 1) - 5) = (3 * 9^r * (8 * W + 5) - 7) / 8`. -/
theorem shifted_valley_d1_mod8_resonance_step5 (r W : Nat) :
    collatzIter (5 * r + 5) ((8 * W + 5) * 2 ^ (3 * r + 1) - 5) =
      (3 * 9 ^ r * (8 * W + 5) - 7) / 8 := by
  have h5 : 5 * r + 5 = 2 + (5 * r + 3) := by omega
  have h8W : 8 * W + 5 = 2 * (4 * W + 2) + 1 := by omega
  rw [h5, collatzIter_add 2 (5 * r + 3), h8W, shifted_valley_d1_odd_prefix_step3_exit r (4 * W + 2) (by omega), ← h8W]
  have h9_mod8 : (9 ^ r) % 8 = 1 := pow9_mod8_eq1 r
  have h9_pos : 1 ≤ 9 ^ r := pow9_pos r
  have hdecomp : 3 * 9 ^ r * (8 * W + 5) = 8 * (3 * 9 ^ r * W) + 15 * 9 ^ r := by
    rw [Nat.mul_add, ← Nat.mul_assoc (3 * 9 ^ r) 8 W, Nat.mul_comm (3 * 9 ^ r) 8, Nat.mul_assoc 8 (3 * 9 ^ r) W]
    have h15 : 3 * 9 ^ r * 5 = 15 * 9 ^ r := by omega
    rw [h15]
  have hdiv8 : (3 * 9 ^ r * (8 * W + 5) - 7) % 8 = 0 := by omega
  exact div2_step2_eq_div8 (3 * 9 ^ r * (8 * W + 5) - 7) hdiv8

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI FAZY `d = 1` RODZINY `-5` W `5r + 5` KROKACH (`r = 0..14`): -/
theorem shifted_valley_d1_mod8_contraction (r W : Nat)
    (hr : 3 * 9 ^ r + 8 ≤ 8 * 2 ^ (3 * r + 1)) :
    let n0 := (8 * W + 5) * 2 ^ (3 * r + 1) - 5
    collatzIter (5 * r + 5) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := shifted_valley_d1_mod8_resonance_step5 r W
  let U := 8 * W + 5
  have hle : (3 * 9 ^ r + 8) * U ≤ (8 * 2 ^ (3 * r + 1)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 8 (2 ^ (3 * r + 1)) U, Nat.mul_comm (2 ^ (3 * r + 1)) U] at hle
  have h9_pos : 1 ≤ 9 ^ r := pow9_pos r
  have h3_ge : 3 ≤ 3 * 9 ^ r := by omega
  have hX_ge : 3 * U ≤ (3 * 9 ^ r) * U := Nat.mul_le_mul_right U h3_ge
  have hU_ge5 : U ≥ 5 := by omega
  have hlt : collatzIter (5 * r + 5) n0 < n0 := by
    show collatzIter (5 * r + 5) ((8 * W + 5) * 2 ^ (3 * r + 1) - 5) < U * 2 ^ (3 * r + 1) - 5
    rw [hcasc]
    change (3 * 9 ^ r * U - 7) / 8 < U * 2 ^ (3 * r + 1) - 5
    omega
  have hge1 : collatzIter (5 * r + 5) n0 ≥ 1 := by
    show collatzIter (5 * r + 5) ((8 * W + 5) * 2 ^ (3 * r + 1) - 5) ≥ 1
    rw [hcasc]
    change (3 * 9 ^ r * U - 7) / 8 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 5) n0 (by omega) hge1 hlt⟩

/-- Dla każdego nieparzystego `B ≥ 3` (`B % 2 = 1`) stan `B * 4 - 7` (`d = 2` rodziny `-7`)
    w 4 krokach Collatza osiąga `(3 * B - 5) / 2`: -/
theorem two_zero_valley_d2_step4_div2 (B : Nat) (hB : B % 2 = 1) (hB3 : B ≥ 3) :
    collatzIter 4 (B * 4 - 7) = (3 * B - 5) / 2 := by
  have s1 : collatzStep (B * 4 - 7) = 12 * B - 20 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (12 * B - 20) = 6 * B - 10 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (6 * B - 10) = 3 * B - 5 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (3 * B - 5) = (3 * B - 5) / 2 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (B * 4 - 7)))) = (3 * B - 5) / 2
  rw [s1, s2, s3, s4]

/-- TWIERDZENIE O WYJŚCIU Z FAZY `d = 5` (`3r + 5 ≡ 2 mod 3`) MAKRO-EROZJI `-7` W `5r + 9` KROKACH:
    Dla dowolnych `r, M ∈ ℕ`:
      `collatzIter (5 * r + 9) ((2 * M + 1) * 2^(3 * r + 5) - 7) = (3 * 9^(r + 1) * (2 * M + 1) - 5) / 2`. -/
theorem two_zero_valley_d5_odd_prefix_step9_exit (r M : Nat) :
    collatzIter (5 * r + 9) ((2 * M + 1) * 2 ^ (3 * r + 5) - 7) =
      (3 * 9 ^ (r + 1) * (2 * M + 1) - 5) / 2 := by
  have h9 : 5 * r + 9 = 4 + 5 * (r + 1) := by omega
  have h5 : 3 * r + 5 = 3 * (r + 1) + 2 := by omega
  -- Wait: two_zero_valley_macro_erosion requires d >= 3, so let's use r steps with d = 5,
  -- followed by two_zero_valley_block_step (from d = 5 to d = 2)!
  -- Even simpler: after 5*r steps with d = 5, we are at (9^r * A) * 32 - 7 = (2 * (9^r * A)) * 16 - 7,
  -- and two_zero_valley_step5 (2 * (9^r * A)) gives 18 * (2 * (9^r * A)) - 7 = (9^(r+1) * A) * 4 - 7!
  have h9_alt : 5 * r + 9 = 4 + (5 + 5 * r) := by omega
  rw [h9_alt, collatzIter_add 4 (5 + 5 * r), collatzIter_add 5 (5 * r)]
  rw [two_zero_valley_macro_erosion r (2 * M + 1) 5 (by omega) (by decide)]
  let B0 := 9 ^ r * (2 * M + 1)
  have hB0_pos : 1 * 1 ≤ B0 := Nat.mul_le_mul (pow9_pos r) (by omega)
  have h32 : B0 * 2 ^ 5 - 7 = 16 * (2 * B0) - 7 := by
    have : 2 ^ 5 = 32 := rfl
    omega
  rw [h32, two_zero_valley_step5 (2 * B0) (by omega)]
  have h36 : 18 * (2 * B0) - 7 = (9 ^ (r + 1) * (2 * M + 1)) * 4 - 7 := by
    have hpow : 9 ^ (r + 1) * (2 * M + 1) = 9 * B0 := by
      show 9 ^ (r + 1) * (2 * M + 1) = 9 * (9 ^ r * (2 * M + 1))
      rw [Nat.pow_succ, Nat.mul_comm (9 ^ r) 9, Nat.mul_assoc]
    omega
  rw [h36]
  have h9_odd : (9 ^ (r + 1)) % 2 = 1 := pow9_odd (r + 1)
  have hB_decomp : 9 ^ (r + 1) * (2 * M + 1) = 2 * (9 ^ (r + 1) * M) + 9 ^ (r + 1) := by
    rw [Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 2, Nat.mul_assoc]
  have hB_odd : (9 ^ (r + 1) * (2 * M + 1)) % 2 = 1 := by omega
  have hB_ge9 : 9 ^ (r + 1) * (2 * M + 1) ≥ 9 := by
    have h9 : 9 ≤ 9 ^ (r + 1) := by
      rw [Nat.pow_succ]
      have := pow9_pos r
      omega
    have := Nat.mul_le_mul h9 (by omega : 1 ≤ 2 * M + 1)
    omega
  rw [two_zero_valley_d2_step4_div2 (9 ^ (r + 1) * (2 * M + 1)) hB_odd (by omega)]
  rw [Nat.mul_assoc 3 (9 ^ (r + 1)) (2 * M + 1)]

/-- TWIERDZENIE O REZONANSIE `mod 8` (`v₂ ≥ 3`) FAZY `d = 5` RODZINY `-7` W `5r + 11` KROKACH:
    Ponieważ `3 * 7 = 21 ≡ 5 (mod 8)`, dla prefiksu `8 * W + 7` (`M = 4 * W + 3`)
    licznik `3 * 9^(r + 1) * (8 * W + 7) - 5` dzieli się przez `8`, dając w `5r + 11` krokach:
      `collatzIter (5 * r + 11) ((8 * W + 7) * 2^(3 * r + 5) - 7) = (3 * 9^(r + 1) * (8 * W + 7) - 5) / 8`. -/
theorem two_zero_valley_d5_mod8_resonance_step11 (r W : Nat) :
    collatzIter (5 * r + 11) ((8 * W + 7) * 2 ^ (3 * r + 5) - 7) =
      (3 * 9 ^ (r + 1) * (8 * W + 7) - 5) / 8 := by
  have h11 : 5 * r + 11 = 2 + (5 * r + 9) := by omega
  have h8W : 8 * W + 7 = 2 * (4 * W + 3) + 1 := by omega
  rw [h11, collatzIter_add 2 (5 * r + 9), h8W, two_zero_valley_d5_odd_prefix_step9_exit r (4 * W + 3), ← h8W]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have h9_pos : 1 ≤ 9 ^ (r + 1) := pow9_pos (r + 1)
  have hdecomp : 3 * 9 ^ (r + 1) * (8 * W + 7) = 8 * (3 * 9 ^ (r + 1) * W) + 21 * 9 ^ (r + 1) := by
    rw [Nat.mul_add, ← Nat.mul_assoc (3 * 9 ^ (r + 1)) 8 W, Nat.mul_comm (3 * 9 ^ (r + 1)) 8, Nat.mul_assoc 8 (3 * 9 ^ (r + 1)) W]
    have h21 : 3 * 9 ^ (r + 1) * 7 = 21 * 9 ^ (r + 1) := by omega
    rw [h21]
  have hdiv8 : (3 * 9 ^ (r + 1) * (8 * W + 7) - 5) % 8 = 0 := by omega
  exact div2_step2_eq_div8 (3 * 9 ^ (r + 1) * (8 * W + 7) - 5) hdiv8

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI FAZY `d = 5` RODZINY `-7` W `5r + 11` KROKACH (`r = 0..20`, do `2^65`!): -/
theorem two_zero_valley_d5_mod8_contraction (r W : Nat)
    (hr : 3 * 9 ^ (r + 1) + 8 ≤ 8 * 2 ^ (3 * r + 5)) :
    let n0 := (8 * W + 7) * 2 ^ (3 * r + 5) - 7
    collatzIter (5 * r + 11) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := two_zero_valley_d5_mod8_resonance_step11 r W
  let U := 8 * W + 7
  have hle : (3 * 9 ^ (r + 1) + 8) * U ≤ (8 * 2 ^ (3 * r + 5)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 8 (2 ^ (3 * r + 5)) U, Nat.mul_comm (2 ^ (3 * r + 5)) U] at hle
  have h9_pos : 1 ≤ 9 ^ (r + 1) := pow9_pos (r + 1)
  have h3_ge : 3 ≤ 3 * 9 ^ (r + 1) := by omega
  have hX_ge : 3 * U ≤ (3 * 9 ^ (r + 1)) * U := Nat.mul_le_mul_right U h3_ge
  have hU_ge7 : U ≥ 7 := by omega
  have hlt : collatzIter (5 * r + 11) n0 < n0 := by
    show collatzIter (5 * r + 11) ((8 * W + 7) * 2 ^ (3 * r + 5) - 7) < U * 2 ^ (3 * r + 5) - 7
    rw [hcasc]
    change (3 * 9 ^ (r + 1) * U - 5) / 8 < U * 2 ^ (3 * r + 5) - 7
    omega
  have hge1 : collatzIter (5 * r + 11) n0 ≥ 1 := by
    show collatzIter (5 * r + 11) ((8 * W + 7) * 2 ^ (3 * r + 5) - 7) ≥ 1
    rw [hcasc]
    change (3 * 9 ^ (r + 1) * U - 5) / 8 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 11) n0 (by omega) hge1 hlt⟩

