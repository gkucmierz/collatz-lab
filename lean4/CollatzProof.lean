    have := pow9_pos r
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 1) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge9 : U ≥ 9 := by omega
  have hlt : collatzIter (5 * r + 7) n0 < n0 := by
    show collatzIter (5 * r + 7) ((8 * W + 1) * 2 ^ (3 * r + 3) - 5) < U * 2 ^ (3 * r + 3) - 5
    rw [hcasc]
    change (9 ^ (r + 1) * U - 5) / 4 < U * 2 ^ (3 * r + 3) - 5
    omega
  have hge1 : collatzIter (5 * r + 7) n0 ≥ 1 := by
    show collatzIter (5 * r + 7) ((8 * W + 1) * 2 ^ (3 * r + 3) - 5) ≥ 1
    rw [hcasc]
    change (9 ^ (r + 1) * U - 5) / 4 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 7) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O SPRZĘŻENIU PRÓŻNIOWYM GAŁĘZI `8W + 1` RODZINY `-7` W `5r + 9` KROKACH:
    Ponieważ `9^(r+1) * (8W + 1) - 7 ≡ 1 - 7 ≡ 2 (mod 8)`, stan w kroku `5r + 6` ma postać
    `Z * 4 + 1` (próg doliny próżniowej!), gdzie `Z = (9^(r+1) * (8W + 1) - 9) / 8`.
    Po kolejnych 3 krokach (`zero_valley_vacuum_step3`, łącznie `5r + 9` kroków):
      `collatzIter (5 * r + 9) ((8 * W + 1) * 2^(3 * r + 3) - 7) = 3 * ((9^(r + 1) * (8 * W + 1) - 9) / 8) + 1`. -/
theorem two_zero_valley_mod8_eq1_step9 (r W : Nat) :
    collatzIter (5 * r + 9) ((8 * W + 1) * 2 ^ (3 * r + 3) - 7) =
      3 * ((9 ^ (r + 1) * (8 * W + 1) - 9) / 8) + 1 := by
  have h9 : 5 * r + 9 = 3 + (5 * r + 6) := by omega
  have hU : 8 * W + 1 = 2 * (4 * W) + 1 := by omega
  rw [h9, collatzIter_add 3 (5 * r + 6), hU, two_zero_valley_odd_prefix_step6_exit r (4 * W), ← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * (8 * W + 1) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 1 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
  have hvac_form : (9 ^ (r + 1) * (8 * W + 1) - 7) / 2 =
      ((9 ^ (r + 1) * (8 * W + 1) - 9) / 8) * 4 + 1 := by omega
  rw [hvac_form]
  exact zero_valley_vacuum_step3 ((9 ^ (r + 1) * (8 * W + 1) - 9) / 8)

/-- TWIERDZENIE O SPRZĘŻENIU PRÓŻNIOWYM GAŁĘZI `8W + 7` RODZINY `-5` W `5r + 9` KROKACH:
    Ponieważ `9^(r+1) * (8W + 7) - 5 ≡ 7 - 5 ≡ 2 (mod 8)`, stan w kroku `5r + 6` ma postać
    `Z * 4 + 1`, gdzie `Z = (9^(r+1) * (8W + 7) - 7) / 8`. Po 3 krokach próżniowych (`5r + 9` kroków):
      `collatzIter (5 * r + 9) ((8 * W + 7) * 2^(3 * r + 3) - 5) = 3 * ((9^(r + 1) * (8 * W + 7) - 7) / 8) + 1`. -/
theorem shifted_valley_mod8_eq7_step9 (r W : Nat) :
    collatzIter (5 * r + 9) ((8 * W + 7) * 2 ^ (3 * r + 3) - 5) =
      3 * ((9 ^ (r + 1) * (8 * W + 7) - 7) / 8) + 1 := by
  have h9 : 5 * r + 9 = 3 + (5 * r + 6) := by omega
  have hU : 8 * W + 7 = 2 * (4 * W + 3) + 1 := by omega
  rw [h9, collatzIter_add 3 (5 * r + 6), hU, shifted_valley_odd_prefix_step6_exit r (4 * W + 3) (by omega), ← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * (8 * W + 7) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 7 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
  have hvac_form : (9 ^ (r + 1) * (8 * W + 7) - 5) / 2 =
