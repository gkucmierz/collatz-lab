    omega
  have hdecomp : 9 ^ (r + 1) * U = 128 * (9 ^ (r + 1) * W) + (5 + 8 * ((3 * s) % 16)) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (128 * W + 5 + 8 * ((3 * s) % 16)) = _
    have hU2 : 128 * W + 5 + 8 * ((3 * s) % 16) = 128 * W + (5 + 8 * ((3 * s) % 16)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 128, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (5 + 8 * ((3 * s) % 16))]
  have hs : s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3 ∨ s = 4 ∨ s = 5 ∨ s = 6 ∨ s = 7 ∨
            s = 8 ∨ s = 9 ∨ s = 10 ∨ s = 11 ∨ s = 12 ∨ s = 13 ∨ s = 14 ∨ s = 15 := by omega
  have hdiv128 : (9 ^ (r + 1) * U - 5) % 128 = 0 := by
    rcases hs with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7 | h8 | h9 | h10 | h11 | h12 | h13 | h14 | h15
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
    · rw [hdecomp, h4]; omega
    · rw [hdecomp, h5]; omega
    · rw [hdecomp, h6]; omega
    · rw [hdecomp, h7]; omega
    · rw [hdecomp, h8]; omega
    · rw [hdecomp, h9]; omega
    · rw [hdecomp, h10]; omega
    · rw [hdecomp, h11]; omega
    · rw [hdecomp, h12]; omega
    · rw [hdecomp, h13]; omega
    · rw [hdecomp, h14]; omega
    · rw [hdecomp, h15]; omega
  exact div2_step6_eq_div128 (9 ^ (r + 1) * U - 5) hdiv128

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 128` RODZINY `-5` (`r = 0..40`, aż do `2^123`!): -/
