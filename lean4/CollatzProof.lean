  have hU : U = 2 * (64 * W + 2 + 4 * ((3 * s) % 16)) + 1 := by omega
  rw [h20, collatzIter_add 6 (5 * r + 14), hU, rle_10111_odd_prefix_step14_exit r (64 * W + 2 + 4 * ((3 * s) % 16)), ← hU]
  have h9_mod128 : (9 ^ (r + 1)) % 128 = 1 + 8 * s := pow9_mod128 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 27 * 9 ^ (r + 1) * U = 128 * (27 * 9 ^ (r + 1) * W) + 27 * (5 + 8 * ((3 * s) % 16)) * 9 ^ (r + 1) := by
    show 27 * 9 ^ (r + 1) * (128 * W + 5 + 8 * ((3 * s) % 16)) = _
    have hU2 : 128 * W + 5 + 8 * ((3 * s) % 16) = 128 * W + (5 + 8 * ((3 * s) % 16)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc (27 * 9 ^ (r + 1)) 128 W, Nat.mul_comm (27 * 9 ^ (r + 1)) 128, Nat.mul_assoc 128 (27 * 9 ^ (r + 1)) W]
    have h27 : 27 * 9 ^ (r + 1) * (5 + 8 * ((3 * s) % 16)) = 27 * (5 + 8 * ((3 * s) % 16)) * 9 ^ (r + 1) := by
      rw [Nat.mul_assoc 27 (9 ^ (r + 1)) (5 + 8 * ((3 * s) % 16)), Nat.mul_comm (9 ^ (r + 1)) (5 + 8 * ((3 * s) % 16)), ← Nat.mul_assoc]
    rw [h27]
  have hs : s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3 ∨ s = 4 ∨ s = 5 ∨ s = 6 ∨ s = 7 ∨
            s = 8 ∨ s = 9 ∨ s = 10 ∨ s = 11 ∨ s = 12 ∨ s = 13 ∨ s = 14 ∨ s = 15 := by omega
  have hdiv128 : (27 * 9 ^ (r + 1) * U - 7) % 128 = 0 := by
    rcases hs with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7 | h8 | h9 | h10 | h11 | h12 | h13 | h14 | h15
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
    · rw [hdecomp, h4]; omega
    · rw [hdecomp, h5]; omega
    · rw [hdecomp, h6]; omega
    · rw [hdecomp, h7]; omega
    · rw [hdecomp, h8]; omega
    · rw [hdecomp, h9]; omega
    · rw [hdecomp, h10]; omega
    · rw [hdecomp, h11]; omega
    · rw [hdecomp, h12]; omega
    · rw [hdecomp, h13]; omega
    · rw [hdecomp, h14]; omega
    · rw [hdecomp, h15]; omega
  exact div2_step6_eq_div128 (27 * 9 ^ (r + 1) * U - 7) hdiv128

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 128` KASKADY RLE `-9` (`r = 0..41`, aż do `2^131`!): -/
theorem rle_10111_mod128_contraction (r W : Nat)
    (hr : 27 * 9 ^ (r + 1) + 256 ≤ 128 * 2 ^ (3 * r + 8)) :
    let s := (r + 1 + 8 * ((r + 1) / 2)) % 16
    let U := 128 * W + 5 + 8 * ((3 * s) % 16)
    let n0 := U * 2 ^ (3 * r + 8) - 9
    collatzIter (5 * r + 20) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro s U n0
  have hcasc : collatzIter (5 * r + 20) n0 = (27 * 9 ^ (r + 1) * U - 7) / 128 :=
    rle_10111_mod128_resonance_step20 r W
  have hle : (27 * 9 ^ (r + 1) + 256) * U ≤ (128 * 2 ^ (3 * r + 8)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 128 (2 ^ (3 * r + 8)) U, Nat.mul_comm (2 ^ (3 * r + 8)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have h27_ge : 243 ≤ 27 * 9 ^ (r + 1) := by omega
  have hX_ge : 243 * U ≤ (27 * 9 ^ (r + 1)) * U :=
    Nat.mul_le_mul_right U h27_ge
  have hU_ge5 : U ≥ 5 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 8) - 9 := rfl
  have hlt : collatzIter (5 * r + 20) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 20) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 20) n0 (by omega) hge1 hlt⟩

