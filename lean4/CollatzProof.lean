/-- TWIERDZENIE O REZONANSIE `mod 16` (`v₂ ≥ 4`) FAZY `d = 1` RODZINY `-5` W `5r + 6` KROKACH:
    Ponieważ `3 * 45 = 135 ≡ 7 (mod 16)` oraz `45 % 16 = 13 = 5 + 8 * 1`, dla prefiksu
    `U = 16 * W + 5 + 8 * ((r + 1) % 2)` licznik `3 * 9^r * U - 7` dzieli się przez `16`,
    dając po `5r + 6` krokach dokładnie `(3 * 9^r * U - 7) / 16`: -/
theorem shifted_valley_d1_mod16_resonance_step6 (r W : Nat) :
    let U := 16 * W + 5 + 8 * ((r + 1) % 2)
    collatzIter (5 * r + 6) (U * 2 ^ (3 * r + 1) - 5) =
      (3 * 9 ^ r * U - 7) / 16 := by
  intro U
  have h6 : 5 * r + 6 = 3 + (5 * r + 3) := by omega
  have hU : U = 2 * (8 * W + 2 + 4 * ((r + 1) % 2)) + 1 := by omega
  rw [h6, collatzIter_add 3 (5 * r + 3), hU, shifted_valley_d1_odd_prefix_step3_exit r (8 * W + 2 + 4 * ((r + 1) % 2)) (by omega), ← hU]
  have h9_mod16 : (9 ^ r) % 16 = 1 + 8 * (r % 2) := pow9_mod16 r
  have h9_pos : 1 ≤ 9 ^ r := pow9_pos r
  have hdecomp : 3 * 9 ^ r * U = 16 * (3 * 9 ^ r * W) + 3 * (5 + 8 * ((r + 1) % 2)) * 9 ^ r := by
    show 3 * 9 ^ r * (16 * W + 5 + 8 * ((r + 1) % 2)) = _
    have hU2 : 16 * W + 5 + 8 * ((r + 1) % 2) = 16 * W + (5 + 8 * ((r + 1) % 2)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc (3 * 9 ^ r) 16 W, Nat.mul_comm (3 * 9 ^ r) 16, Nat.mul_assoc 16 (3 * 9 ^ r) W]
    have h3 : 3 * 9 ^ r * (5 + 8 * ((r + 1) % 2)) = 3 * (5 + 8 * ((r + 1) % 2)) * 9 ^ r := by
      rw [Nat.mul_assoc 3 (9 ^ r) (5 + 8 * ((r + 1) % 2)), Nat.mul_comm (9 ^ r) (5 + 8 * ((r + 1) % 2)), ← Nat.mul_assoc]
    rw [h3]
  have hp : r % 2 = 0 ∨ r % 2 = 1 := by omega
  have hdiv16 : (3 * 9 ^ r * U - 7) % 16 = 0 := by
    rcases hp with h0 | h1
    · have hr1 : (r + 1) % 2 = 1 := by omega
      rw [hdecomp, hr1]; omega
    · have hr1 : (r + 1) % 2 = 0 := by omega
      rw [hdecomp, hr1]; omega
  exact div2_step3_eq_div16 (3 * 9 ^ r * U - 7) hdiv16

