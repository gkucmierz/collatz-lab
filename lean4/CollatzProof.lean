--           ORAZ PRAWO REZONANSU `9^k % 16 = 1 + 8*(k % 2)` (`v₂ ≥ 4`, KONTRAKCJA DO `r = 22`, `2^69`)
-- =============================================================================

/-- Dla dowolnego `N` spełniającego `N % 8 = 6` cztery kolejne kroki Collatza z `N / 2`
    są w pełni deterministyczne (nieparzysty -> parzysty -> nieparzysty -> parzysty)
    i dają `(9 * N + 10) / 8`: -/
theorem mod8_eq6_step4 (N : Nat) (hN : N % 8 = 6) :
    collatzIter 4 (N / 2) = (9 * N + 10) / 8 := by
  have s1 : collatzStep (N / 2) = (3 * N + 2) / 2 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep ((3 * N + 2) / 2) = (3 * N + 2) / 4 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep ((3 * N + 2) / 4) = (9 * N + 10) / 4 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep ((9 * N + 10) / 4) = (9 * N + 10) / 8 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (N / 2)))) = (9 * N + 10) / 8
  rw [s1, s2, s3, s4]

/-- TWIERDZENIE O WYJŚCIU CZWARTEJ GAŁĘZI `8W + 5` RODZINY `-7` W `5r + 10` KROKACH:
    Ponieważ `9^(r+1) * (8W + 5) - 7 ≡ 5 - 7 ≡ 6 (mod 8)`, po `5r + 10` krokach:
      `collatzIter (5 * r + 10) ((8 * W + 5) * 2^(3 * r + 3) - 7) = (9^(r + 2) * (8 * W + 5) - 53) / 8`. -/
theorem two_zero_valley_mod8_eq5_step10 (r W : Nat) :
    collatzIter (5 * r + 10) ((8 * W + 5) * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 2) * (8 * W + 5) - 53) / 8 := by
  have h10 : 5 * r + 10 = 4 + (5 * r + 6) := by omega
  have hU : 8 * W + 5 = 2 * (4 * W + 2) + 1 := by omega
  rw [h10, collatzIter_add 4 (5 * r + 6), hU, two_zero_valley_odd_prefix_step6_exit r (4 * W + 2), ← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * (8 * W + 5) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 5 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
