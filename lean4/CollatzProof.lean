/-- TWIERDZENIE O SPRZĘŻENIU DWÓCH BLOKÓW MAKRO-EROZJI RLE (`v₁ = 2`, `c₁ = 7 → c₂ = 7`):
    Jeżeli po przejściu pierwszego bloku `r1` z waluacją wyjścia `v₁ = 2` (`U1 = 8 * W1 + 3`)
    zachodzi równanie sprzężenia `9^(r1 + 1) * (8 * W1 + 3) + 21 = (2 * M2 + 1) * (4 * 2^(3 * r2 + 3))`,
    to wyjście pierwszego bloku wchodzi bezpośrednio w drugi blok makro-erozji `r2`,
    dając po `5 * (r1 + r2) + 13` krokach stan `(9^(r2 + 1) * (2 * M2 + 1) - 7) / 2`: -/
theorem two_block_rle_coupling_v1_eq2_step13 (r1 r2 W1 M2 : Nat)
    (hcouple : 9 ^ (r1 + 1) * (8 * W1 + 3) + 21 = (2 * M2 + 1) * (4 * 2 ^ (3 * r2 + 3))) :
    collatzIter (5 * (r1 + r2) + 13) ((8 * W1 + 3) * 2 ^ (3 * r1 + 3) - 7) =
      (9 ^ (r2 + 1) * (2 * M2 + 1) - 7) / 2 := by
  have hsplit : 5 * (r1 + r2) + 13 = (5 * r2 + 6) + (5 * r1 + 7) := by omega
  rw [hsplit, collatzIter_add (5 * r2 + 6) (5 * r1 + 7)]
  have hpos2 : 2 ^ (3 * r2 + 3) ≥ 8 := by
    have h1 := pow2_pos (3 * r2)
    change 2 ^ (3 * r2 + 3) ≥ 8
    rw [Nat.pow_add]; omega
  have hmul_assoc : (2 * M2 + 1) * (4 * 2 ^ (3 * r2 + 3)) = 4 * ((2 * M2 + 1) * 2 ^ (3 * r2 + 3)) := by
    rw [← Nat.mul_assoc, Nat.mul_comm (2 * M2 + 1) 4, Nat.mul_assoc]
  rw [hmul_assoc] at hcouple
  have hblock1 : collatzIter (5 * r1 + 7) ((8 * W1 + 3) * 2 ^ (3 * r1 + 3) - 7) =
      (2 * M2 + 1) * 2 ^ (3 * r2 + 3) - 7 := by
    rw [two_zero_valley_mod8_eq3_step7 r1 W1]
    omega
  rw [hblock1]
  exact two_zero_valley_odd_prefix_step6_exit r2 M2

/-- TWIERDZENIE O REZONANSIE DWUBLOKOWYM RLE (`v₁ = 2, v₂ = 3`) W `5 * (r1 + r2) + 15` KROKACH: -/
theorem two_block_rle_coupling_v1_eq2_v2_eq3_step15 (r1 r2 W1 W2 : Nat)
    (hcouple : 9 ^ (r1 + 1) * (8 * W1 + 3) + 21 = (8 * W2 + 7) * (4 * 2 ^ (3 * r2 + 3))) :
    collatzIter (5 * (r1 + r2) + 15) ((8 * W1 + 3) * 2 ^ (3 * r1 + 3) - 7) =
      (9 ^ (r2 + 1) * (8 * W2 + 7) - 7) / 8 := by
  have hsplit : 5 * (r1 + r2) + 15 = (5 * r2 + 8) + (5 * r1 + 7) := by omega
  rw [hsplit, collatzIter_add (5 * r2 + 8) (5 * r1 + 7)]
  have hpos2 : 2 ^ (3 * r2 + 3) ≥ 8 := by
    have h1 := pow2_pos (3 * r2)
    change 2 ^ (3 * r2 + 3) ≥ 8
    rw [Nat.pow_add]; omega
  have hmul_assoc : (8 * W2 + 7) * (4 * 2 ^ (3 * r2 + 3)) = 4 * ((8 * W2 + 7) * 2 ^ (3 * r2 + 3)) := by
    rw [← Nat.mul_assoc, Nat.mul_comm (8 * W2 + 7) 4, Nat.mul_assoc]
  rw [hmul_assoc] at hcouple
  have hblock1 : collatzIter (5 * r1 + 7) ((8 * W1 + 3) * 2 ^ (3 * r1 + 3) - 7) =
      (8 * W2 + 7) * 2 ^ (3 * r2 + 3) - 7 := by
    rw [two_zero_valley_mod8_eq3_step7 r1 W1]
    omega
  rw [hblock1]
