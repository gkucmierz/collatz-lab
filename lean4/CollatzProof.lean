  rw [h12, collatzIter_add 6 (5 * r + 6), hU, shifted_valley_odd_prefix_step6_exit r (64 * W + 2 + 4 * ((3 * s) % 16)) (by omega), ← hU]
  have h9_mod128 : (9 ^ (r + 1)) % 128 = 1 + 8 * s := pow9_mod128 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
