-- CZĘŚĆ 14. ZAMKNIĘTA FORMA ANALITYCZNA `mersennePrefixIter` ORAZ TWIERDZENIE
--           O DWUBLOKOWEJ KASKADZIE RLE (`...1^(a₂) 0 1^(a₁)₂`)
-- =============================================================================

/-- Dokładna tożsamość zamkniętej formy dla iterowanego prefiksu Mersenne'a (`M ↦ 3*M + 1`):
    Dla każdej liczby kroków `r : Nat` oraz dowolnego prefiksu `M : Nat` zachodzi:
      `2 * (mersennePrefixIter r M) + 1 = 3^r * (2 * M + 1)`.
    Tożsamość ta linearyzuje nieliniową rekurencję `M_{i+1} = 3*M_i + 1` bez użycia odejmowania! -/
theorem mersennePrefixIter_closed_form (r M : Nat) :
    2 * (mersennePrefixIter r M) + 1 = 3 ^ r * (2 * M + 1) := by
  induction r generalizing M with
  | zero =>
    simp [mersennePrefixIter]
  | succ r ih =>
    unfold mersennePrefixIter
    rw [ih (3 * M + 1)]
    have h1 : 2 * (3 * M + 1) + 1 = 3 * (2 * M + 1) := by omega
    rw [h1, ← Nat.mul_assoc, ← Nat.pow_succ]

/-- Dokładny obraz kroku `3x + 1` po całkowitym wyczerpaniu dolnego bloku Mersenne'a `1^(r+1)₂`:
    Niech `M' = mersennePrefixIter r M` oznacza prefiks po `r` krokach `syracuseV1`
    na liczbie `mersenneTail M (r + 1)`. Wówczas w kolejnym kroku nieparzystym zachodzi:
      `3 * (mersenneTail M' 1) + 1 + 2 = 2 * 3^(r + 1) * (2 * M + 1)`. -/
theorem mersenne_exhaustion_next_odd_step (r M : Nat) :
    let M' := mersennePrefixIter r M
    3 * (mersenneTail M' 1) + 3 = 2 * (3 ^ (r + 1) * (2 * M + 1)) := by
  intro M'
  have hclosed : 2 * M' + 1 = 3 ^ r * (2 * M + 1) := mersennePrefixIter_closed_form r M
  have htail : 3 * (mersenneTail M' 1) + 3 = 6 * (2 * M' + 1) := by
    unfold mersenneTail
    omega
  rw [htail, hclosed]
  calc 6 * (3 ^ r * (2 * M + 1))
    _ = (2 * 3) * (3 ^ r * (2 * M + 1)) := rfl
    _ = 2 * (3 * (3 ^ r * (2 * M + 1))) := by rw [Nat.mul_assoc]
    _ = 2 * ((3 ^ r * 3) * (2 * M + 1)) := by
      rw [← Nat.mul_assoc 3 (3 ^ r), Nat.mul_comm 3 (3 ^ r)]
    _ = 2 * (3 ^ (r + 1) * (2 * M + 1)) := by rw [← Nat.pow_succ]

/-- Twierdzenie o dwublokowej strukturze RLE (`...0 1^(a₂) 0 1^(a₁)₂`):
    Gdy nad dolnym blokiem `0 1^(r+1)₂` znajduje się górny blok `a₂` jedynek
    (`M = P * 2^a₂ + (2^a₂ - 1)`, czyli `M + 1 = (P + 1) * 2^a₂`),
    wyrażenie `(2 * M + 1) + 1` przyjmuje dokładną postać `(P + 1) * 2^(a₂ + 1)`,
    co po `r` krokach `syracuseV1` sprzęga bezpośrednio górny blok `2^(a₂ + 1)` z mnożnikiem `3^r`! -/
theorem two_block_rle_coupling_identity (r P a2 : Nat) :
    let M := P * 2 ^ a2 + (2 ^ a2 - 1)
    2 * (mersennePrefixIter r M) + 1 + 3 ^ r = 3 ^ r * ((P + 1) * 2 ^ (a2 + 1)) := by
  intro M
  rw [mersennePrefixIter_closed_form r M]
  have hM1 : M + 1 = (P + 1) * 2 ^ a2 := by
    have hpos : 2 ^ a2 ≥ 1 := Nat.one_le_two_pow
    have hadd : (P + 1) * 2 ^ a2 = P * 2 ^ a2 + 2 ^ a2 := by
      rw [Nat.add_mul, Nat.one_mul]
    show P * 2 ^ a2 + (2 ^ a2 - 1) + 1 = (P + 1) * 2 ^ a2
    omega
  have hM2 : (2 * M + 1) + 1 = (P + 1) * 2 ^ (a2 + 1) := by
    calc (2 * M + 1) + 1
      _ = 2 * (M + 1) := by omega
      _ = 2 * ((P + 1) * 2 ^ a2) := by rw [hM1]
      _ = (P + 1) * (2 ^ a2 * 2) := by
        rw [← Nat.mul_assoc 2 (P + 1), Nat.mul_comm 2 (P + 1), Nat.mul_assoc, Nat.mul_comm 2 (2 ^ a2)]
      _ = (P + 1) * 2 ^ (a2 + 1) := by rw [← Nat.pow_succ]
  calc 3 ^ r * (2 * M + 1) + 3 ^ r
    _ = 3 ^ r * (2 * M + 1) + 3 ^ r * 1 := by rw [Nat.mul_one]
    _ = 3 ^ r * ((2 * M + 1) + 1) := by rw [← Nat.mul_add]
    _ = 3 ^ r * ((P + 1) * 2 ^ (a2 + 1)) := by rw [hM2]

