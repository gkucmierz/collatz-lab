/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI GAŁĘZI PRÓŻNIOWEJ `8W + 1` RODZINY `-7` (`r = 0..7`):
    Dla każdego `r ∈ ℕ` spełniającego `3 * 9^(r + 1) + 8 ≤ 8 * 2^(3 * r + 3)` (`r = 0..7`)
    oraz każdego `W ≥ 1`:
      `collatzIter (5 * r + 9) ((8 * W + 1) * 2^(3 * r + 3) - 7) < (8 * W + 1) * 2^(3 * r + 3) - 7`. -/
theorem two_zero_valley_mod8_eq1_contraction (r W : Nat) (hW : W ≥ 1)
    (hr : 3 * 9 ^ (r + 1) + 8 ≤ 8 * 2 ^ (3 * r + 3)) :
    let n0 := (8 * W + 1) * 2 ^ (3 * r + 3) - 7
    collatzIter (5 * r + 9) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := two_zero_valley_mod8_eq1_step9 r W
  let U := 8 * W + 1
  have hle : (3 * 9 ^ (r + 1) + 8) * U ≤ (8 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 3, Nat.mul_assoc 8, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 1) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge9 : U ≥ 9 := by omega
  have hlt : collatzIter (5 * r + 9) n0 < n0 := by
    show collatzIter (5 * r + 9) ((8 * W + 1) * 2 ^ (3 * r + 3) - 7) < U * 2 ^ (3 * r + 3) - 7
    rw [hcasc]
    change 3 * ((9 ^ (r + 1) * U - 9) / 8) + 1 < U * 2 ^ (3 * r + 3) - 7
    omega
  have hge1 : collatzIter (5 * r + 9) n0 ≥ 1 := by
    show collatzIter (5 * r + 9) ((8 * W + 1) * 2 ^ (3 * r + 3) - 7) ≥ 1
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 9) n0 (by omega) hge1 hlt⟩

