-- CZĘŚĆ 30. UNIWERSALNA REDUKCJA POTĘG DWÓJKI (`collatzIter_even_pow2`) ORAZ
--           KLASYFIKACJA `mod 8` WYJŚCIA Z MAKRO-EROZJI (`8W+3`, `8W+1`, `8W+7`)
-- =============================================================================

/-- Uniwersalny lemat o czystej redukcji potęgi dwójki:
    Dla dowolnych `s, Q ∈ ℕ` po `s` krokach Collatza liczba `Q * 2^s` przechodzi w `Q`: -/
theorem collatzIter_even_pow2 (s Q : Nat) :
    collatzIter s (Q * 2 ^ s) = Q := by
  induction s generalizing Q with
  | zero => simp [collatzIter]
  | succ s ih =>
    rw [collatzIter_succ_right s (Q * 2 ^ (s + 1))]
    have hpow : Q * 2 ^ (s + 1) = (Q * 2) * 2 ^ s := by
      rw [Nat.pow_succ, ← Nat.mul_assoc, Nat.mul_assoc Q (2 ^ s) 2, Nat.mul_comm (2 ^ s) 2, ← Nat.mul_assoc]
    rw [hpow, ih (Q * 2)]
    unfold collatzStep
    split <;> omega

/-- Jeżeli `N % 4 = 0`, to z `N / 2` jeden krok Collatza wykonuje dzielenie przez 2, dając `N / 4`: -/
theorem div2_step1_eq_div4 (N : Nat) (hN : N % 4 = 0) :
    collatzStep (N / 2) = N / 4 := by
  unfold collatzStep
  split <;> omega

/-- TWIERDZENIE O WYJŚCIU `8W + 3` Z MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 7` KROKACH:
    Ponieważ `9^(r+1) * (8W + 3) - 7 ≡ 3 - 7 ≡ 4 (mod 8)` jest zawsze podzielne przez `4`,
    stan w kroku `5r + 6` jest parzysty i w kroku `5r + 7` ulega dzieleniu przez 2:
      `collatzIter (5 * r + 7) ((8 * W + 3) * 2^(3 * r + 3) - 7) = (9^(r + 1) * (8 * W + 3) - 7) / 4`. -/
theorem two_zero_valley_mod8_eq3_step7 (r W : Nat) :
    collatzIter (5 * r + 7) ((8 * W + 3) * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * (8 * W + 3) - 7) / 4 := by
  have hsucc : collatzIter (5 * r + 7) ((8 * W + 3) * 2 ^ (3 * r + 3) - 7) =
      collatzStep (collatzIter (5 * r + 6) ((8 * W + 3) * 2 ^ (3 * r + 3) - 7)) :=
    collatzIter_succ_right (5 * r + 6) ((8 * W + 3) * 2 ^ (3 * r + 3) - 7)
  have hU : 8 * W + 3 = 2 * (4 * W + 1) + 1 := by omega
  rw [hsucc, hU, two_zero_valley_odd_prefix_step6_exit r (4 * W + 1), ← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have hdecomp : 9 ^ (r + 1) * (8 * W + 3) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 3 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
  have hdiv4 : (9 ^ (r + 1) * (8 * W + 3) - 7) % 4 = 0 := by omega
  exact div2_step1_eq_div4 (9 ^ (r + 1) * (8 * W + 3) - 7) hdiv4

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI GAŁĘZI `8W + 3` RODZINY `-7` (`r = 0..10`):
    Dla każdego `r ∈ ℕ` spełniającego `9^(r + 1) + 8 ≤ 4 * 2^(3 * r + 3)` (czyli `r = 0..10`)
    oraz każdego `W ∈ ℕ`:
      `collatzIter (5 * r + 7) ((8 * W + 3) * 2^(3 * r + 3) - 7) < (8 * W + 3) * 2^(3 * r + 3) - 7`. -/
theorem two_zero_valley_mod8_eq3_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 8 ≤ 4 * 2 ^ (3 * r + 3)) :
    let n0 := (8 * W + 3) * 2 ^ (3 * r + 3) - 7
    collatzIter (5 * r + 7) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := two_zero_valley_mod8_eq3_step7 r W
  let U := 8 * W + 3
  have hle : (9 ^ (r + 1) + 8) * U ≤ (4 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 1) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge3 : U ≥ 3 := by omega
  have hlt : collatzIter (5 * r + 7) n0 < n0 := by
    show collatzIter (5 * r + 7) ((8 * W + 3) * 2 ^ (3 * r + 3) - 7) < U * 2 ^ (3 * r + 3) - 7
    rw [hcasc]
    change (9 ^ (r + 1) * U - 7) / 4 < U * 2 ^ (3 * r + 3) - 7
    omega
  have hge1 : collatzIter (5 * r + 7) n0 ≥ 1 := by
    show collatzIter (5 * r + 7) ((8 * W + 3) * 2 ^ (3 * r + 3) - 7) ≥ 1
    rw [hcasc]
    change (9 ^ (r + 1) * U - 7) / 4 ≥ 1
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 7) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O WYJŚCIU `8W + 1` Z MAKRO-EROZJI PRZESUNIĘTEJ (`-5`) W `5r + 7` KROKACH:
    Ponieważ `9^(r+1) * (8W + 1) - 5 ≡ 1 - 5 ≡ 4 (mod 8)` jest podzielne przez `4`,
    dla każdego `W ≥ 1`:
      `collatzIter (5 * r + 7) ((8 * W + 1) * 2^(3 * r + 3) - 5) = (9^(r + 1) * (8 * W + 1) - 5) / 4`. -/
theorem shifted_valley_mod8_eq1_step7 (r W : Nat) (hW : W ≥ 1) :
    collatzIter (5 * r + 7) ((8 * W + 1) * 2 ^ (3 * r + 3) - 5) =
      (9 ^ (r + 1) * (8 * W + 1) - 5) / 4 := by
  have hsucc : collatzIter (5 * r + 7) ((8 * W + 1) * 2 ^ (3 * r + 3) - 5) =
      collatzStep (collatzIter (5 * r + 6) ((8 * W + 1) * 2 ^ (3 * r + 3) - 5)) :=
    collatzIter_succ_right (5 * r + 6) ((8 * W + 1) * 2 ^ (3 * r + 3) - 5)
  have hU : 8 * W + 1 = 2 * (4 * W) + 1 := by omega
  rw [hsucc, hU, shifted_valley_odd_prefix_step6_exit r (4 * W) (by omega), ← hU]
  have h9_mod8 : (9 ^ (r + 1)) % 8 = 1 := pow9_mod8_eq1 (r + 1)
  have hdecomp : 9 ^ (r + 1) * (8 * W + 1) = 8 * (9 ^ (r + 1) * W) + 9 ^ (r + 1) * 1 := by
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 8, Nat.mul_assoc]
  have hdiv4 : (9 ^ (r + 1) * (8 * W + 1) - 5) % 4 = 0 := by omega
  exact div2_step1_eq_div4 (9 ^ (r + 1) * (8 * W + 1) - 5) hdiv4

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI GAŁĘZI `8W + 1` RODZINY `-5` (`r = 0..10`): -/
theorem shifted_valley_mod8_eq1_contraction (r W : Nat) (hW : W ≥ 1)
    (hr : 9 ^ (r + 1) + 4 ≤ 4 * 2 ^ (3 * r + 3)) :
    let n0 := (8 * W + 1) * 2 ^ (3 * r + 3) - 5
    collatzIter (5 * r + 7) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro n0
  have hcasc := shifted_valley_mod8_eq1_step7 r W hW
  let U := 8 * W + 1
  have hle : (9 ^ (r + 1) + 4) * U ≤ (4 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
