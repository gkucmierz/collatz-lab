-- =============================================================================
-- CZĘŚĆ 20. UNIWERSALNE PRAWO ZACHOWANIA WYKŁADNICZEGO SUFIKSU MERSENNE'A
--           (`mersenneTail_exponential_conservation`) ORAZ RODZINY `M_{37}..M_{40}`
-- =============================================================================

/-- Tożsamość dopełnienia dwójkowego ogona Mersenne'a (`mersenneTail_add_one`):
    Dla dowolnego `r ≥ 0` i dowolnego prefiksu `M ≥ 0`:
      `mersenneTail M (r + 1) + 1 = 2^(r + 1) * (2 * M + 1)`. -/
theorem mersenneTail_add_one (r M : Nat) :
    mersenneTail M (r + 1) + 1 = 2 ^ (r + 1) * (2 * M + 1) := by
  unfold mersenneTail
  have hp : 2 ^ (r + 1 + 1) = 2 ^ (r + 1) * 2 := by rw [Nat.pow_succ]
  have hm : M * 2 ^ (r + 1 + 1) = 2 ^ (r + 1) * (2 * M) := by
    rw [hp, ← Nat.mul_assoc, Nat.mul_comm M (2 ^ (r + 1)), Nat.mul_assoc, Nat.mul_comm M 2]
  have hrhs : 2 ^ (r + 1) * (2 * M + 1) = 2 ^ (r + 1) * (2 * M) + 2 ^ (r + 1) := by
    rw [Nat.mul_add, Nat.mul_one]
  have hpos : 2 ^ (r + 1) ≥ 1 := Nat.one_le_two_pow
  omega

/-- UNIWERSALNE PRAWO ZACHOWANIA WYKŁADNICZEGO SUFIKSU MERSENNE'A
    (`mersenneTail_exponential_conservation`):
    Niech `n₀ = mersenneTail M (r + 1)` będzie dowolną liczbą z `(r + 1)`-bitowym sufiksem jedynek.
    Wówczas prefiks `M` znika całkowicie z relacji pomiędzy `n₀` a stanem po wyczerpaniu sufiksu:
    1. Dla `N₃ = collatzIter (2 * r + 3) n₀`:
         `2^(r + 1) * (2 * N₃ + 1) = 3^(r + 1) * (n₀ + 1)`.
    2. W gałęzi nieparzystego rezonansu `(M + r) % 2 = 1`, dla `N₄ = collatzIter (2 * r + 4) n₀`:
         `2^(r + 1) * (4 * N₄ + 1) = 3^(r + 1) * (n₀ + 1)`. -/
theorem mersenneTail_exponential_conservation (r M : Nat) :
    let n0 := mersenneTail M (r + 1)
    let N3 := collatzIter (2 * r + 3) n0
    let N4 := collatzIter (2 * r + 4) n0
    2 ^ (r + 1) * (2 * N3 + 1) = 3 ^ (r + 1) * (n0 + 1) ∧
    ((M + r) % 2 = 1 → 2 ^ (r + 1) * (4 * N4 + 1) = 3 ^ (r + 1) * (n0 + 1)) := by
  intro n0 N3 N4
  have hN3 : N3 = mersennePrefixIter (r + 1) M :=
    (collatzIter_mersenneTail_eq_mersennePrefixIter r M).1
  constructor
  · calc 2 ^ (r + 1) * (2 * N3 + 1)
      _ = 2 ^ (r + 1) * (3 ^ (r + 1) * (2 * M + 1)) := by
        rw [hN3, mersennePrefixIter_closed_form (r + 1) M]
      _ = (2 ^ (r + 1) * 3 ^ (r + 1)) * (2 * M + 1) := by rw [← Nat.mul_assoc]
      _ = (3 ^ (r + 1) * 2 ^ (r + 1)) * (2 * M + 1) := by rw [Nat.mul_comm (2 ^ (r + 1)) (3 ^ (r + 1))]
      _ = 3 ^ (r + 1) * (2 ^ (r + 1) * (2 * M + 1)) := by rw [Nat.mul_assoc]
      _ = 3 ^ (r + 1) * (n0 + 1) := by rw [← mersenneTail_add_one r M]
  · intro hres
    have hexh : collatzIter (2 * r) n0 = mersenneTail (mersennePrefixIter r M) 1 := by
      show collatzIter (2 * r) (mersenneTail M (r + 1)) = _
      have h0 : r + 1 = r + 0 + 1 := by omega
      rw [h0, collatzIter_eq_syracuseV1Iter_mersenneTail r M 0,
          deterministic_k1_run_exhaustion r M 0]
    have hN4_eq : N4 = collatzIter 4 (mersenneTail (mersennePrefixIter r M) 1) := by
      show collatzIter (2 * r + 4) n0 = _
      have hadd4 : 2 * r + 4 = 4 + 2 * r := by omega
      rw [hadd4, collatzIter_add 4 (2 * r), hexh]
    have hodd_cf : 4 * N4 + 1 = 3 ^ (r + 1) * (2 * M + 1) := by
      rw [hN4_eq]
      exact rle_odd_resonance_closed_form r M hres
    calc 2 ^ (r + 1) * (4 * N4 + 1)
      _ = 2 ^ (r + 1) * (3 ^ (r + 1) * (2 * M + 1)) := by rw [hodd_cf]
      _ = (2 ^ (r + 1) * 3 ^ (r + 1)) * (2 * M + 1) := by rw [← Nat.mul_assoc]
      _ = (3 ^ (r + 1) * 2 ^ (r + 1)) * (2 * M + 1) := by rw [Nat.mul_comm (2 ^ (r + 1)) (3 ^ (r + 1))]
      _ = 3 ^ (r + 1) * (2 ^ (r + 1) * (2 * M + 1)) := by rw [Nat.mul_assoc]
      _ = 3 ^ (r + 1) * (n0 + 1) := by rw [← mersenneTail_add_one r M]

/-- Ogólne kryterium kontrakcji horyzontowej dla `(r + 1)`-bitowego sufiksu Mersenne'a
    w gałęzi nieparzystego rezonansu `(M + r) % 2 = 1`:
    jeżeli `3^(r + 1) * (n₀ + 1) < 2^(r + 1) * (4 * n₀ + 1)`, to po `2 * r + 4` krokach
    zachodzi ścisły spadek `collatzIter (2 * r + 4) n₀ < n₀`! -/
theorem mersenneTail_general_odd_resonance_contraction (r M : Nat)
    (hres : (M + r) % 2 = 1)
    (hbound : 3 ^ (r + 1) * (mersenneTail M (r + 1) + 1) <
              2 ^ (r + 1) * (4 * mersenneTail M (r + 1) + 1)) :
    collatzIter (2 * r + 4) (mersenneTail M (r + 1)) < mersenneTail M (r + 1) := by
  have hcons := (mersenneTail_exponential_conservation r M).2 hres
  have hlt : 2 ^ (r + 1) * (4 * collatzIter (2 * r + 4) (mersenneTail M (r + 1)) + 1) <
             2 ^ (r + 1) * (4 * mersenneTail M (r + 1) + 1) := by
    rw [hcons]
    exact hbound
  have h_not_le : ¬ (mersenneTail M (r + 1) ≤ collatzIter (2 * r + 4) (mersenneTail M (r + 1))) := by
    intro hle
    have hle4 : 4 * mersenneTail M (r + 1) + 1 ≤
                4 * collatzIter (2 * r + 4) (mersenneTail M (r + 1)) + 1 := by omega
    have hmul := Nat.mul_le_mul_left (2 ^ (r + 1)) hle4
    omega
  omega

/-- Uniwersalne domknięcie horyzontowe z prawa rezonansu parzystości dla `r = 1` (`...0011₂`, 6 kroków)
    oraz `r = 2` (`...10111₂`, 8 kroków) jako bezpośredni wniosek z prawa zachowania wykładniczego: -/
theorem mersenneTail_universal_contraction_r1_and_r2 (M : Nat) :
    (M % 2 = 0 → collatzIter 6 (mersenneTail M 2) < mersenneTail M 2) ∧
    (M % 2 = 1 → collatzIter 8 (mersenneTail M 3) < mersenneTail M 3) := by
  constructor
  · intro h_even
    have hres1 : (M + 1) % 2 = 1 := by omega
    have hn0 : mersenneTail M 2 ≥ 3 := by unfold mersenneTail; omega
    have hb1 : 3 ^ (1 + 1) * (mersenneTail M 2 + 1) < 2 ^ (1 + 1) * (4 * mersenneTail M 2 + 1) := by omega
    exact mersenneTail_general_odd_resonance_contraction 1 M hres1 hb1
  · intro h_odd
    have hres2 : (M + 2) % 2 = 1 := by omega
    have hn0 : mersenneTail M 3 ≥ 7 := by unfold mersenneTail; omega
    have hb2 : 3 ^ (2 + 1) * (mersenneTail M 3 + 1) < 2 ^ (2 + 1) * (4 * mersenneTail M 3 + 1) := by omega
    exact mersenneTail_general_odd_resonance_contraction 2 M hres2 hb2

