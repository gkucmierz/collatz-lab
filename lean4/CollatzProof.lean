  have hpow : A * 2 ^ (3 * r + 7) - 13 = 16 * (A * 2 ^ (3 * r + 3)) - 13 := by
    have h2 : 2 ^ (3 * r + 7) = 16 * 2 ^ (3 * r + 3) := by
      change 2 ^ ((3 * r + 3) + 4) = 16 * 2 ^ (3 * r + 3)
      rw [Nat.pow_add]
      omega
    rw [h2, ← Nat.mul_assoc, Nat.mul_comm A 16, Nat.mul_assoc]
  have hY : 1 * 1 ≤ A * 2 ^ (3 * r + 3) := Nat.mul_le_mul hA (pow2_pos (3 * r + 3))
  have h6 := (rle_capture_10011_to_minus7 (A * 2 ^ (3 * r + 3)) (by omega)).1
  have hmul9 : 9 * (A * 2 ^ (3 * r + 3)) = (9 * A) * 2 ^ (3 * r + 3) := by
    rw [← Nat.mul_assoc]
  rw [h9, collatzIter_add (5 * r + 3) 6, hpow, h6, hmul9]
  rw [two_zero_valley_universal_step3_exit r (9 * A) (by omega)]
  have hpow9 : 9 ^ r * (9 * A) = 9 ^ (r + 1) * A := by
    rw [← Nat.mul_assoc, ← Nat.pow_succ]
  rw [hpow9]

