theorem horizon_drop_even (k : Nat) (hk : k ≥ 1) : HasHorizonDrop (2 * k) := by
  refine ⟨1, by omega, ?_⟩
  have h1 : collatzIter 1 (2 * k) = k := by
    simp [collatzIter, collatzStep_even]
  rw [h1]
  unfold V_id
  omega

