/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 256` KASKADY RLE `-9` (`r = 0..47`, aż do `2^149`!): -/
theorem rle_10111_mod256_contraction (r W : Nat)
    (hr : 27 * 9 ^ (r + 1) + 512 ≤ 256 * 2 ^ (3 * r + 8)) :
    let s := (r + 1 + 8 * ((r + 1) / 2) + 16 * ((r + 1) / 4) + 16 * ((r + 2) / 4)) % 32
    let U := 256 * W + 5 + 8 * ((3 * s + 16 + 16 * (s / 2)) % 32)
    let n0 := U * 2 ^ (3 * r + 8) - 9
    collatzIter (5 * r + 21) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro s U n0
  have hcasc : collatzIter (5 * r + 21) n0 = (27 * 9 ^ (r + 1) * U - 7) / 256 :=
    rle_10111_mod256_resonance_step21 r W
  have hle : (27 * 9 ^ (r + 1) + 512) * U ≤ (256 * 2 ^ (3 * r + 8)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 256 (2 ^ (3 * r + 8)) U, Nat.mul_comm (2 ^ (3 * r + 8)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have h27_ge : 243 ≤ 27 * 9 ^ (r + 1) := by omega
  have hX_ge : 243 * U ≤ (27 * 9 ^ (r + 1)) * U :=
    Nat.mul_le_mul_right U h27_ge
  have hU_ge5 : U ≥ 5 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 8) - 9 := rfl
  have hlt : collatzIter (5 * r + 21) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 21) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 21) n0 (by omega) hge1 hlt⟩

