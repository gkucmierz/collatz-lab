/-- TWIERDZENIE O GŁĘBOKIM REZONANSIE `mod 512` (`v₂ ≥ 9`) DLA FAZY `3r + 1` RODZINY `-5` W `5r + 11` KROKACH: -/
theorem shifted_valley_d1_mod512_resonance_step11 (r W : Nat) :
    let s := (r + 8 * (r / 2) + 16 * (r / 4) + 16 * ((r + 1) / 4) +
              32 * (r / 8) + 32 * ((r + 1) / 8) + 32 * ((r + 2) / 8) + 32 * ((r + 3) / 8)) % 64
    let U := 512 * W + 5 + 8 * ((11 * s + 21 + 32 * (s / 4) + 16 * ((s + 1) / 4) + 48 * ((s + 3) / 4)) % 64)
    collatzIter (5 * r + 11) (U * 2 ^ (3 * r + 1) - 5) =
      (3 * 9 ^ r * U - 7) / 512 := by
  intro s U
  let t := (11 * s + 21 + 32 * (s / 4) + 16 * ((s + 1) / 4) + 48 * ((s + 3) / 4)) % 64
  have h11 : 5 * r + 11 = 8 + (5 * r + 3) := by omega
  have hU : U = 2 * (256 * W + 2 + 4 * t) + 1 := by omega
  rw [h11, collatzIter_add 8 (5 * r + 3), hU, shifted_valley_d1_odd_prefix_step3_exit r (256 * W + 2 + 4 * t) (by omega), ← hU]
  have h9_mod512 : (9 ^ r) % 512 = 1 + 8 * s := pow9_mod512 r
  have hU_assoc : U = 512 * W + (5 + 8 * t) := by omega
  have hres : (3 * (5 + 8 * t) * (1 + 8 * s)) % 512 = 7 % 512 :=
    checkResonanceTable_sound 512 3 5 7
      (fun x => (11 * x + 21 + 32 * (x / 4) + 16 * ((x + 1) / 4) + 48 * ((x + 3) / 4)) % 64)
      64 s (by decide) (by omega)
  have hdiv512 : (3 * 9 ^ r * U - 7) % 512 = 0 := by
    rw [hU_assoc]
    exact mod512_linear_inverse 3 (9 ^ r) W (5 + 8 * t) 7 (1 + 8 * s) h9_mod512 hres
  exact div2_step8_eq_div512 (3 * 9 ^ r * U - 7) hdiv512

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI `mod 512` FAZY `3r + 1` RODZINY `-5` (`r = 0..49`, aż do `2^148`!): -/
