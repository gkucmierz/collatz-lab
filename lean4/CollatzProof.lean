/-- Lemat pomocniczy: każda potęga dwójki jest dodatnia (`2^k ≥ 1`). -/
theorem pow2_pos (k : Nat) : 2 ^ k ≥ 1 := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- TWIERDZENIE O UNIWERSALNYM WYJŚCIU Z KASKADY RLE `-13` (`...10011₂`) W `5r + 9` KROKACH:
    Dla dowolnego `r ∈ ℕ` oraz `A ≥ 1`, liczba `A * 2^(3 * r + 7) - 13` w 6 krokach ulega
    przechwyceniu przez atraktor `-7` (`9 * A * 2^(3 * r + 3) - 7`), a po kolejnych `5r + 3`
    krokach makro-erozji osiąga dokładnie `6 * (9^(r + 1) * A) - 5`: -/
theorem rle_10011_macro_erosion_step9_exit (r A : Nat) (hA : A ≥ 1) :
