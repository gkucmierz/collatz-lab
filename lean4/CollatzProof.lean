-- CZĘŚĆ 19. TWIERDZENIE O KANONICZNEJ REDUKCJI SUFIKSU
--           `collatzIter (2r + 3) = mersennePrefixIter (r + 1)`,
--           DWOISTOŚĆ SEPARATORA RLE ORAZ RODZINY MERSENNE'A `M_{31}..M_{36}`
-- =============================================================================

/-- Lemat o prawostronnym kroku iteracji prefiksu Mersenne'a (`mersennePrefixIter_succ_right`):
    `mersennePrefixIter (r + 1) M = 3 * (mersennePrefixIter r M) + 1`. -/
theorem mersennePrefixIter_succ_right (r M : Nat) :
    mersennePrefixIter (r + 1) M = 3 * (mersennePrefixIter r M) + 1 := by
  have h1 : 2 * (mersennePrefixIter (r + 1) M) + 1 = 3 ^ (r + 1) * (2 * M + 1) :=
    mersennePrefixIter_closed_form (r + 1) M
  have h2 : 2 * (mersennePrefixIter r M) + 1 = 3 ^ r * (2 * M + 1) :=
    mersennePrefixIter_closed_form r M
  have hpow : 3 ^ (r + 1) * (2 * M + 1) = 3 * (3 ^ r * (2 * M + 1)) := by
    rw [Nat.pow_succ, Nat.mul_comm (3 ^ r) 3, Nat.mul_assoc]
  omega

/-- TWIERDZENIE O CAŁKOWITEJ ANIHILACJI SUFIKSU MERSENNE'A (`collatzIter_mersenneTail_eq_mersennePrefixIter`):
    Dla każdego `r ≥ 0` i dowolnego prefiksu `M ≥ 0`:
    1. Dokładnie `2 * r + 3` klasyczne kroki Collatza na liczbie `mersenneTail M (r + 1)`
       całkowicie anihilują `(r + 1)`-bitowy ogon jedynek wraz z separującym zerem,
       dając dokładnie `mersennePrefixIter (r + 1) M`!
    2. Gdy `(M + r) % 2 = 1`, kolejny (`2 * r + 4`-ty) krok wykonuje dodatkowe dzielenie przez 2,
       dając `(mersennePrefixIter (r + 1) M) / 2`. -/
theorem collatzIter_mersenneTail_eq_mersennePrefixIter (r M : Nat) :
    collatzIter (2 * r + 3) (mersenneTail M (r + 1)) = mersennePrefixIter (r + 1) M ∧
    ((M + r) % 2 = 1 →
      collatzIter (2 * r + 4) (mersenneTail M (r + 1)) = (mersennePrefixIter (r + 1) M) / 2) := by
  have hcasc := collatzIter_two_block_rle_cascade r M
  have hsucc := mersennePrefixIter_succ_right r M
  constructor
  · rw [hcasc.1, hsucc]
  · intro hres
    rw [hcasc.2 hres, hsucc]

/-- Każdy niepusty górny blok jedynek `1^(m+1)₂` nad pojedynczym zerem
    (`M = P * 2^(m + 1) + (2^(m + 1) - 1)`) jest bezwarunkowo liczbą nieparzystą (`M % 2 = 1`). -/
theorem upper_mersenne_block_odd (P m : Nat) :
    (P * 2 ^ (m + 1) + (2 ^ (m + 1) - 1)) % 2 = 1 := by
  have hp : 2 ^ (m + 1) = 2 * 2 ^ m := by
    rw [Nat.pow_succ, Nat.mul_comm]
  have hm : P * 2 ^ (m + 1) = 2 * (P * 2 ^ m) := by
    rw [hp, ← Nat.mul_assoc, Nat.mul_comm P 2, Nat.mul_assoc]
  have hpos : 2 ^ m ≥ 1 := Nat.one_le_two_pow
  omega

/-- Twierdzenie o dwublokowym tunelowaniu przez pojedyncze zero (`single_zero_separator_odd_block_tunneling`):
    Dla dowolnej liczby dwublokowej `...0 1^(m+1) 0 1^(r+1)₂` o nieparzystej długości dolnego bloku
    (`r % 2 = 0`, czyli `a₁ = r + 1` nieparzyste) i dowolnej długości górnego bloku `a₂ = m + 1 ≥ 1`:
    po `2 * r + 4` klasycznych krokach Collatza stan `N₄ = collatzIter (2 * r + 4) (mersenneTail M (r + 1))`
    spełnia dokładne równanie sprzężenia dwublokowego:
      `4 * N₄ + 1 + 3^(r + 1) = 3^(r + 1) * ((P + 1) * 2^(m + 2))`. -/
theorem single_zero_separator_odd_block_tunneling (r P m : Nat) (hr_even : r % 2 = 0) :
    let M := P * 2 ^ (m + 1) + (2 ^ (m + 1) - 1)
    let N4 := collatzIter (2 * r + 4) (mersenneTail M (r + 1))
    4 * N4 + 1 + 3 ^ (r + 1) = 3 ^ (r + 1) * ((P + 1) * 2 ^ (m + 2)) := by
  intro M N4
  have hM_odd : M % 2 = 1 := upper_mersenne_block_odd P m
  have hres : (M + r) % 2 = 1 := by omega
  have hexh : collatzIter (2 * r) (mersenneTail M (r + 1)) = mersenneTail (mersennePrefixIter r M) 1 := by
    have h0 : r + 1 = r + 0 + 1 := by omega
    rw [h0, collatzIter_eq_syracuseV1Iter_mersenneTail r M 0,
        deterministic_k1_run_exhaustion r M 0]
  have hN4_eq : N4 = collatzIter 4 (mersenneTail (mersennePrefixIter r M) 1) := by
    show collatzIter (2 * r + 4) (mersenneTail M (r + 1)) = _
    have hadd4 : 2 * r + 4 = 4 + 2 * r := by omega
    rw [hadd4, collatzIter_add 4 (2 * r), hexh]
  have hodd_cf : 4 * N4 + 1 = 3 ^ (r + 1) * (2 * M + 1) := by
    rw [hN4_eq]
    exact rle_odd_resonance_closed_form r M hres
  have hcoupl : 2 * (mersennePrefixIter (r + 1) M) + 1 + 3 ^ (r + 1) = 3 ^ (r + 1) * ((P + 1) * 2 ^ (m + 2)) :=
    two_block_rle_coupling_identity (r + 1) P (m + 1)
  have hclosed_succ : 2 * (mersennePrefixIter (r + 1) M) + 1 = 3 ^ (r + 1) * (2 * M + 1) :=
    mersennePrefixIter_closed_form (r + 1) M
  rw [hodd_cf, ← hclosed_succ]
  exact hcoupl

