-- CZĘŚĆ 51. PODNOŚNIK HENSELA `pow9_mod1024` (OKRES 128, `v₂ = 10`), REZONANS `v₂ ≥ 10` (`mod 1024`)
--           DLA 4 GŁÓWNYCH RODZIN (`-7`, `-5` DO `2^174`, `-13` DO `2^193`, `-9` DO `2^185`),
--           SPRZĘŻENIE LONTU JEDNO-ZEROWEGO I TRÓJBLOKOWE RLE (`K = 3`) ORAZ SITO `k = 181..189` (`m = 295..308`)
-- =============================================================================

/-- Zwarta tożsamość biliniowa dla `(9^k) % 1024` (okres 128, `v₂ = 10`, Most Biliniowy): -/
theorem pow9_mod1024_compact (k : Nat) :
    (9 ^ k) % 1024 = 1 + 8 * ((k + 8 * (k / 2) + 80 * (k / 4) + 80 * ((k + 1) / 4) +
      32 * (k % 4) * (k / 4)) % 128) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ, Nat.mul_mod, ih]
    have hp : k % 4 = 0 ∨ k % 4 = 1 ∨ k % 4 = 2 ∨ k % 4 = 3 := by omega
    rcases hp with h0 | h1 | h2 | h3
    · have h0' : (k + 1) % 4 = 1 := by omega
      rw [h0, h0']; omega
    · have h1' : (k + 1) % 4 = 2 := by omega
      rw [h1, h1']; omega
    · have h2' : (k + 1) % 4 = 3 := by omega
      rw [h2, h2']; omega
    · have h3' : (k + 1) % 4 = 0 := by omega
      rw [h3, h3']; omega

/-- Redukcja sumy ośmiu podłóg `64 * ((k + j) / 16)` modulo 128 do członu parzystości: -/
theorem sum8_div16_mod128 (k : Nat) :
    (64 * (k / 16) + 64 * ((k + 1) / 16) + 64 * ((k + 2) / 16) + 64 * ((k + 3) / 16) +
     64 * ((k + 4) / 16) + 64 * ((k + 5) / 16) + 64 * ((k + 6) / 16) + 64 * ((k + 7) / 16)) % 128 =
    (64 * (k % 2) * (k / 8)) % 128 := by
  have hp : k % 2 = 0 ∨ k % 2 = 1 := by omega
  rcases hp with h0 | h1
  · rw [h0]; omega
  · rw [h1]; omega

/-- Redukcja sumy czterech podłóg `32 * ((k + j) / 8)` modulo 128 do członu modulo 4: -/
theorem sum4_div8_mod128 (k : Nat) :
    (32 * (k / 8) + 32 * ((k + 1) / 8) + 32 * ((k + 2) / 8) + 32 * ((k + 3) / 8) +
      64 * (k % 2) * (k / 8)) % 128 =
    (32 * (k % 4) * (k / 4)) % 128 := by
  have hp : k % 8 = 0 ∨ k % 8 = 1 ∨ k % 8 = 2 ∨ k % 8 = 3 ∨
            k % 8 = 4 ∨ k % 8 = 5 ∨ k % 8 = 6 ∨ k % 8 = 7 := by omega
  rcases hp with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
  · have ha : k % 2 = 0 := by omega
    have hb : k % 4 = 0 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 1 := by omega
    have hb : k % 4 = 1 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 0 := by omega
    have hb : k % 4 = 2 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 1 := by omega
    have hb : k % 4 = 3 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 0 := by omega
    have hb : k % 4 = 0 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 1 := by omega
    have hb : k % 4 = 1 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 0 := by omega
    have hb : k % 4 = 2 := by omega
    rw [ha, hb]; omega
  · have ha : k % 2 = 1 := by omega
    have hb : k % 4 = 3 := by omega
    rw [ha, hb]; omega

/-- Twierdzenie o 2-adycznej okresowości potęg dziewiątki modulo 1024 (okres 128, Podnośnik Hensela `v₂ = 10`):
    Wyprowadzone w `< 15 000` heartbeats przez Most Biliniowy (`pow9_mod1024_compact`, `sum8_div16_mod128`, `sum4_div8_mod128`). -/
theorem pow9_mod1024 (k : Nat) :
    (9 ^ k) % 1024 = 1 + 8 * ((k + 8 * (k / 2) + 80 * (k / 4) + 80 * ((k + 1) / 4) +
      32 * (k / 8) + 32 * ((k + 1) / 8) + 32 * ((k + 2) / 8) + 32 * ((k + 3) / 8) +
      64 * (k / 16) + 64 * ((k + 1) / 16) + 64 * ((k + 2) / 16) + 64 * ((k + 3) / 16) +
      64 * ((k + 4) / 16) + 64 * ((k + 5) / 16) + 64 * ((k + 6) / 16) + 64 * ((k + 7) / 16)) % 128) := by
  rw [pow9_mod1024_compact k]
  congr 2
  generalize hA : k + 8 * (k / 2) + 80 * (k / 4) + 80 * ((k + 1) / 4) = A
  generalize hB : 32 * (k / 8) + 32 * ((k + 1) / 8) + 32 * ((k + 2) / 8) + 32 * ((k + 3) / 8) = B
  generalize hC : 64 * (k / 16) + 64 * ((k + 1) / 16) + 64 * ((k + 2) / 16) + 64 * ((k + 3) / 16) +
                  64 * ((k + 4) / 16) + 64 * ((k + 5) / 16) + 64 * ((k + 6) / 16) + 64 * ((k + 7) / 16) = C
  generalize hD : 64 * (k % 2) * (k / 8) = D
  generalize hE : 32 * (k % 4) * (k / 4) = E
  have h1 : C % 128 = D % 128 := by rw [← hC, ← hD]; exact sum8_div16_mod128 k
  have h2 : (B + D) % 128 = E % 128 := by rw [← hB, ← hD, ← hE]; exact sum4_div8_mod128 k
  have hABC : A + 32 * (k / 8) + 32 * ((k + 1) / 8) + 32 * ((k + 2) / 8) + 32 * ((k + 3) / 8) +
      64 * (k / 16) + 64 * ((k + 1) / 16) + 64 * ((k + 2) / 16) + 64 * ((k + 3) / 16) +
      64 * ((k + 4) / 16) + 64 * ((k + 5) / 16) + 64 * ((k + 6) / 16) + 64 * ((k + 7) / 16) = A + B + C := by omega
  rw [hABC]
  omega

/-- Lemat o 9 krokach parzystych przy podzielności przez 1024 (`v₂ ≥ 10`): -/
theorem div2_step9_eq_div1024 (N : Nat) (hN : N % 1024 = 0) :
    collatzIter 9 (N / 2) = N / 1024 := by
  have s8 : collatzIter 8 (N / 2) = N / 512 := div2_step8_eq_div512 N (by omega)
  change collatzStep (collatzIter 8 (N / 2)) = N / 1024
  rw [s8]
  unfold collatzStep
  split <;> omega

/-- Lemat o liniowej inwersji `mod 1024` (`mod1024_linear_inverse`) dla `v₂ ≥ 10`: -/
theorem mod1024_linear_inverse (A M W u0 c b : Nat)
    (hM : M % 1024 = b)
    (hres : (A * u0 * b) % 1024 = c % 1024) :
    (A * M * (1024 * W + u0) - c) % 1024 = 0 := by
  have hdecomp : A * M * (1024 * W + u0) = 1024 * (A * M * W) + A * u0 * M := by
    rw [Nat.mul_add, ← Nat.mul_assoc (A * M) 1024 W, Nat.mul_comm (A * M) 1024,
        Nat.mul_assoc 1024 (A * M) W, Nat.mul_assoc A M u0, Nat.mul_comm M u0, ← Nat.mul_assoc A u0 M]
  have hmod1 : (A * u0 * M) % 1024 = (A * u0 * b) % 1024 := by
    rw [Nat.mul_mod (A * u0) M 1024, hM, Nat.mul_mod (A * u0) b 1024]
    have hb : b % 1024 = b := by omega
    rw [hb]
  have hmod2 : (A * u0 * M) % 1024 = c % 1024 := by rw [hmod1, hres]
  omega

/-- TWIERDZENIE O REZONANSIE `mod 1024` (`v₂ ≥ 10`) RODZINY `-7` (`two_zero_valley`) W `5r + 15` KROKACH: -/
theorem two_zero_valley_mod1024_resonance_step15 (r W : Nat) :
    let s := (r + 1 + 8 * ((r + 1) / 2) + 80 * ((r + 1) / 4) + 80 * ((r + 2) / 4) +
              32 * ((r + 1) / 8) + 32 * ((r + 2) / 8) + 32 * ((r + 3) / 8) + 32 * ((r + 4) / 8) +
              64 * ((r + 1) / 16) + 64 * ((r + 2) / 16) + 64 * ((r + 3) / 16) + 64 * ((r + 4) / 16) +
              64 * ((r + 5) / 16) + 64 * ((r + 6) / 16) + 64 * ((r + 7) / 16) + 64 * ((r + 8) / 16)) % 128
    let U := 1024 * W + 7 + 8 * ((113 * s + 112 * (s / 2) + 96 * (s / 4) + 96 * ((s + 1) / 4) +
              64 * (s / 8) + 64 * ((s + 1) / 8) + 64 * ((s + 2) / 8) + 64 * ((s + 3) / 8)) % 128)
    collatzIter (5 * r + 15) (U * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * U - 7) / 1024 := by
  intro s U
  generalize ht : (113 * s + 112 * (s / 2) + 96 * (s / 4) + 96 * ((s + 1) / 4) +
    64 * (s / 8) + 64 * ((s + 1) / 8) + 64 * ((s + 2) / 8) + 64 * ((s + 3) / 8)) % 128 = t
  have hs_lt : s < 128 := Nat.mod_lt _ (by decide)
  have hU_def : U = 1024 * W + 7 + 8 * t := by dsimp [U]; rw [ht]
  have h15 : 5 * r + 15 = 9 + (5 * r + 6) := by omega
