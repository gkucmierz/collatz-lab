-- CZĘŚĆ 35. 2-ADYCZNA OKRESOWOŚĆ POTĘG DZIEWIĄTKI `mod 32` (`pow9_mod32`) ORAZ
--           REZONANS `v₂ ≥ 5` (`5r + 10` KROKÓW) ROZCIĄGAJĄCY KONTRAKCJĘ DO `r = 28` (`2^87`!)
-- =============================================================================

/-- Twierdzenie o 2-adycznej okresowości potęg dziewiątki modulo 32 (okres 4):
    Dla każdego `k ∈ ℕ` zachodzi `(9^k) % 32 = 1 + 8 * (k % 4)`: -/
theorem pow9_mod32 (k : Nat) : (9 ^ k) % 32 = 1 + 8 * (k % 4) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Lemat o 4 krokach parzystych przy podzielności przez 32 (`v₂ ≥ 5`): -/
theorem div2_step4_eq_div32 (N : Nat) (hN : N % 32 = 0) :
    collatzIter 4 (N / 2) = N / 32 := by
  have s1 : collatzStep (N / 2) = N / 4 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (N / 4) = N / 8 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (N / 8) = N / 16 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (N / 16) = N / 32 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (N / 2)))) = N / 32
  rw [s1, s2, s3, s4]

/-- TWIERDZENIE O REZONANSIE `mod 32` (`v₂ ≥ 5`) DLA MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 10` KROKACH:
    Ponieważ `(1 + 8m)(7 + 8m) = 64m(m + 1) + 7 ≡ 7 (mod 32)` dla każdego `m ∈ {0, 1, 2, 3}`,
    dla prefiksu `U = 32 * W + 7 + 8 * ((r + 1) % 4)` licznik `9^(r + 1) * U - 7` dzieli się
    przez `32`, dając po `5r + 10` krokach dokładnie `(9^(r + 1) * U - 7) / 32`: -/
theorem two_zero_valley_mod32_resonance_step10 (r W : Nat) :
    let U := 32 * W + 7 + 8 * ((r + 1) % 4)
    collatzIter (5 * r + 10) (U * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * U - 7) / 32 := by
  intro U
  have h10 : 5 * r + 10 = 4 + (5 * r + 6) := by omega
  have hU : U = 2 * (16 * W + 3 + 4 * ((r + 1) % 4)) + 1 := by omega
  rw [h10, collatzIter_add 4 (5 * r + 6), hU, two_zero_valley_odd_prefix_step6_exit r (16 * W + 3 + 4 * ((r + 1) % 4)), ← hU]
  have h9_mod32 : (9 ^ (r + 1)) % 32 = 1 + 8 * ((r + 1) % 4) := pow9_mod32 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * U = 32 * (9 ^ (r + 1) * W) + (7 + 8 * ((r + 1) % 4)) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (32 * W + 7 + 8 * ((r + 1) % 4)) = _
    have hU2 : 32 * W + 7 + 8 * ((r + 1) % 4) = 32 * W + (7 + 8 * ((r + 1) % 4)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 32, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (7 + 8 * ((r + 1) % 4))]
  have hp : (r + 1) % 4 = 0 ∨ (r + 1) % 4 = 1 ∨ (r + 1) % 4 = 2 ∨ (r + 1) % 4 = 3 := by omega
  have hdiv32 : (9 ^ (r + 1) * U - 7) % 32 = 0 := by
    rcases hp with h0 | h1 | h2 | h3
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
  exact div2_step4_eq_div32 (9 ^ (r + 1) * U - 7) hdiv32

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 32` RODZINY `-7` (`r = 0..28`, aż do `2^87`!): -/
theorem two_zero_valley_mod32_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 32 ≤ 32 * 2 ^ (3 * r + 3)) :
    let U := 32 * W + 7 + 8 * ((r + 1) % 4)
    let n0 := U * 2 ^ (3 * r + 3) - 7
    collatzIter (5 * r + 10) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro U n0
  have hcasc : collatzIter (5 * r + 10) n0 = (9 ^ (r + 1) * U - 7) / 32 :=
    two_zero_valley_mod32_resonance_step10 r W
  have hle : (9 ^ (r + 1) + 32) * U ≤ (32 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 32 (2 ^ (3 * r + 3)) U, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hX_ge : 9 * U ≤ 9 ^ (r + 1) * U :=
    Nat.mul_le_mul_right U h9_ge9
  have hU_ge7 : U ≥ 7 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 3) - 7 := rfl
  have hlt : collatzIter (5 * r + 10) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 10) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 10) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O REZONANSIE `mod 32` (`v₂ ≥ 5`) DLA MAKRO-EROZJI PRZESUNIĘTEJ (`-5`) W `5r + 10` KROKACH: -/
theorem shifted_valley_mod32_resonance_step10 (r W : Nat) :
    let U := 32 * W + 5 + 8 * ((3 * ((r + 1) % 4)) % 4)
    collatzIter (5 * r + 10) (U * 2 ^ (3 * r + 3) - 5) =
      (9 ^ (r + 1) * U - 5) / 32 := by
  intro U
  have h10 : 5 * r + 10 = 4 + (5 * r + 6) := by omega
  have hU : U = 2 * (16 * W + 2 + 4 * ((3 * ((r + 1) % 4)) % 4)) + 1 := by omega
  rw [h10, collatzIter_add 4 (5 * r + 6), hU, shifted_valley_odd_prefix_step6_exit r (16 * W + 2 + 4 * ((3 * ((r + 1) % 4)) % 4)) (by omega), ← hU]
  have h9_mod32 : (9 ^ (r + 1)) % 32 = 1 + 8 * ((r + 1) % 4) := pow9_mod32 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * U = 32 * (9 ^ (r + 1) * W) + (5 + 8 * ((3 * ((r + 1) % 4)) % 4)) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (32 * W + 5 + 8 * ((3 * ((r + 1) % 4)) % 4)) = _
    have hU2 : 32 * W + 5 + 8 * ((3 * ((r + 1) % 4)) % 4) = 32 * W + (5 + 8 * ((3 * ((r + 1) % 4)) % 4)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 32, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (5 + 8 * ((3 * ((r + 1) % 4)) % 4))]
  have hp : (r + 1) % 4 = 0 ∨ (r + 1) % 4 = 1 ∨ (r + 1) % 4 = 2 ∨ (r + 1) % 4 = 3 := by omega
  have hdiv32 : (9 ^ (r + 1) * U - 5) % 32 = 0 := by
    rcases hp with h0 | h1 | h2 | h3
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
  exact div2_step4_eq_div32 (9 ^ (r + 1) * U - 5) hdiv32

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 32` RODZINY `-5` (`r = 0..28`, aż do `2^87`!): -/
theorem shifted_valley_mod32_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 32 ≤ 32 * 2 ^ (3 * r + 3)) :
