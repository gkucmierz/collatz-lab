-- CZĘŚĆ 16. PEŁNA KASKADA DWUBLOKOWA RLE, ZAMKNIĘTE NIEZMIENNIKI PO TUNELOWANIU
--           ORAZ DOMKNIĘCIE POZIOMU `k = 26` (`mod 67108864`, `98.4542%`) I `M_{25}..M_{30}`
-- =============================================================================

/-- Dokładny krok wyjścia `collatzIter 3` z wyczerpanego ogona `mersenneTail M 1 = 4 * M + 1`:
    Niezależnie od parzystości prefiksu `M`, dokładnie 3 klasyczne kroki Collatza
    przeprowadzają `mersenneTail M 1` w `3 * M + 1`, co dla każdego `M ≥ 1` daje
    ścisłą kontrakcję `collatzIter 3 (mersenneTail M 1) < mersenneTail M 1`. -/
theorem mersenne_exhaustion_step3_drop (M : Nat) :
    collatzIter 3 (mersenneTail M 1) = 3 * M + 1 ∧
    (M ≥ 1 → collatzIter 3 (mersenneTail M 1) < mersenneTail M 1) := by
  have hs0 : collatzIter 3 (mersenneTail M 1) = collatzStep (collatzStep (collatzStep (mersenneTail M 1))) := rfl
  have hs1 : collatzStep (mersenneTail M 1) = 12 * M + 4 := by
    unfold collatzStep mersenneTail
    have h0 : (M * 2 ^ (1 + 1) + (2 ^ 1 - 1)) % 2 = 1 := by omega
    simp [h0]
    omega
  have hs2 : collatzStep (12 * M + 4) = 6 * M + 2 := by
    unfold collatzStep
    have h1 : (12 * M + 4) % 2 = 0 := by omega
    simp [h1]
    omega
  have hs3 : collatzStep (6 * M + 2) = 3 * M + 1 := by
    unfold collatzStep
    have h2 : (6 * M + 2) % 2 = 0 := by omega
    simp [h2]
    omega
  rw [hs0, hs1, hs2, hs3]
  refine ⟨rfl, ?_⟩
  unfold mersenneTail
  intro hM
  omega

/-- Gdy prefiks `M` jest nieparzysty (`M % 2 = 1`), stan `3 * M + 1` po 3 krokach jest parzysty,
    więc 4-ty krok Collatza wykonuje dodatkowe dzielenie przez 2 (`v₂ ≥ 3`), dając
    `collatzIter 4 (mersenneTail M 1) = (3 * M + 1) / 2 < mersenneTail M 1` dla każdego `M ≥ 0`. -/
theorem mersenne_exhaustion_step4_odd_tunneling (M : Nat) (hodd : M % 2 = 1) :
    collatzIter 4 (mersenneTail M 1) = (3 * M + 1) / 2 ∧
    2 * collatzIter 4 (mersenneTail M 1) = 3 * M + 1 ∧
    collatzIter 4 (mersenneTail M 1) < mersenneTail M 1 := by
  have h4 : collatzIter 4 (mersenneTail M 1) = collatzStep (collatzIter 3 (mersenneTail M 1)) :=
    collatzIter_succ_right 3 (mersenneTail M 1)
  have h3 : collatzIter 3 (mersenneTail M 1) = 3 * M + 1 := (mersenne_exhaustion_step3_drop M).1
  have hs4 : collatzStep (3 * M + 1) = (3 * M + 1) / 2 := by
    unfold collatzStep
    have heven : (3 * M + 1) % 2 = 0 := by omega
    simp [heven]
  rw [h4, h3, hs4]
  refine ⟨rfl, ?_, ?_⟩
  · omega
  · unfold mersenneTail
    omega

/-- Zamknięty niezmiennik kaskady RLE w gałęzi parzystego rezonansu (`(M + r) % 2 = 0`, `v₂ = 2`):
    Po wyczerpaniu dolnego bloku `1^(r+1)₂` (`r` kroków `syracuseV1`) i 3 krokach klasycznych
    Collatza z `mersenneTail M' 1`, otrzymany stan `N'' = collatzIter 3 (mersenneTail M' 1)`
    spełnia dokładną tożsamość wykładniczą:
      `2 * N'' + 1 = 3^(r + 1) * (2 * M + 1)`. -/
theorem rle_even_resonance_closed_form (r M : Nat) :
    let M' := mersennePrefixIter r M
    let N'' := collatzIter 3 (mersenneTail M' 1)
    2 * N'' + 1 = 3 ^ (r + 1) * (2 * M + 1) := by
  intro M' N''
  have hN : N'' = 3 * M' + 1 := (mersenne_exhaustion_step3_drop M').1
  have hclosed : 2 * M' + 1 = 3 ^ r * (2 * M + 1) := mersennePrefixIter_closed_form r M
  have hstep : 2 * N'' + 1 = 3 * (2 * M' + 1) := by omega
  rw [hstep, hclosed]
  calc 3 * (3 ^ r * (2 * M + 1))
    _ = (3 * 3 ^ r) * (2 * M + 1) := by rw [← Nat.mul_assoc]
    _ = (3 ^ r * 3) * (2 * M + 1) := by rw [Nat.mul_comm 3 (3 ^ r)]
    _ = 3 ^ (r + 1) * (2 * M + 1) := by rw [← Nat.pow_succ]

/-- Zamknięty niezmiennik kaskady RLE w gałęzi nieparzystego rezonansu (`(M + r) % 2 = 1`, `v₂ ≥ 3`):
    Po wyczerpaniu dolnego bloku `1^(r+1)₂` (`r` kroków `syracuseV1`) i 4 krokach klasycznych
    Collatza z `mersenneTail M' 1` (tunelowanie przez pojedyncze zero!), otrzymany stan
    `N'' = collatzIter 4 (mersenneTail M' 1)` spełnia dokładną tożsamość wykładniczą:
      `4 * N'' + 1 = 3^(r + 1) * (2 * M + 1)`. -/
theorem rle_odd_resonance_closed_form (r M : Nat) (hres : (M + r) % 2 = 1) :
    let M' := mersennePrefixIter r M
    let N'' := collatzIter 4 (mersenneTail M' 1)
    4 * N'' + 1 = 3 ^ (r + 1) * (2 * M + 1) := by
  intro M' N''
  have hpar : M' % 2 = (M + r) % 2 := mersennePrefixIter_parity r M
  have hodd : M' % 2 = 1 := by omega
  have h2N : 2 * N'' = 3 * M' + 1 := (mersenne_exhaustion_step4_odd_tunneling M' hodd).2.1
  have hclosed : 2 * M' + 1 = 3 ^ r * (2 * M + 1) := mersennePrefixIter_closed_form r M
  have hstep : 4 * N'' + 1 = 3 * (2 * M' + 1) := by omega
  rw [hstep, hclosed]
  calc 3 * (3 ^ r * (2 * M + 1))
    _ = (3 * 3 ^ r) * (2 * M + 1) := by rw [← Nat.mul_assoc]
    _ = (3 ^ r * 3) * (2 * M + 1) := by rw [Nat.mul_comm 3 (3 ^ r)]
    _ = 3 ^ (r + 1) * (2 * M + 1) := by rw [← Nat.pow_succ]

