/-- Lemat o alternacji parzystości prefiksu Mersenne'a (`mersennePrefixIter_parity`):
    Każdy pojedynczy krok `M ↦ 3 * M + 1` odwraca parzystość prefiksu `M`,
    wobec czego po `r` krokach zachodzi dokładna tożsamość:
      `(mersennePrefixIter r M) % 2 = (M + r) % 2`. -/
theorem mersennePrefixIter_parity (r M : Nat) :
    (mersennePrefixIter r M) % 2 = (M + r) % 2 := by
  induction r generalizing M with
  | zero =>
    simp [mersennePrefixIter]
  | succ r ih =>
    unfold mersennePrefixIter
    rw [ih (3 * M + 1)]
    omega

/-- TWIERDZENIE O REZONANSIE PARZYSTOŚCI TUNELOWANIA RLE (`rle_parity_resonance_tunneling`):
    Po wyczerpaniu dolnego bloku Mersenne'a o długości `a₁ = r + 1` (do postaci `mersenneTail M' 1`),
    kolejny krok nieparzysty `3 * (mersenneTail M' 1) + 1`:
    1. Daje tunelowanie przez zero (`8 ∣ (3x + 1)`, czyli `v₂ ≥ 3`) wtedy i tylko wtedy, gdy
       `(M + r) % 2 = 1` (tzn. długość bloku `a₁ = r + 1` oraz prefiks `M` mają tę samą parzystość!).
    2. Daje dokładne dzielenie przez `4` (`(3x + 1) % 8 = 4`, czyli `v₂ = 2`) wtedy i tylko wtedy, gdy
       `(M + r) % 2 = 0` (przeciwna parzystość `a₁` oraz `M`). -/
theorem rle_parity_resonance_tunneling (r M : Nat) :
    let M' := mersennePrefixIter r M
    ((M + r) % 2 = 1 → (3 * mersenneTail M' 1 + 1) % 8 = 0) ∧
    ((M + r) % 2 = 0 → (3 * mersenneTail M' 1 + 1) % 8 = 4) := by
  intro M'
  have hpar : M' % 2 = (M + r) % 2 := mersennePrefixIter_parity r M
  unfold mersenneTail
  constructor <;> intro h <;> omega

