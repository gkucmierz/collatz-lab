-- =============================================================================
-- CZĘŚĆ 39. 2-ADYCZNA OKRESOWOŚĆ POTĘG DZIEWIĄTKI `mod 128` (`pow9_mod128`),
--           REZONANS `v₂ ≥ 7` (`5r + 12` KROKÓW) DO `r = 40` (`2^123`!) ORAZ `k = 67..75`
-- =============================================================================

/-- Twierdzenie o 2-adycznej okresowości potęg dziewiątki modulo 128 (okres 16):
    Dla każdego `k ∈ ℕ` zachodzi:
      `(9^k) % 128 = 1 + 8 * ((k + 8 * (k / 2)) % 16)`. -/
theorem pow9_mod128 (k : Nat) : (9 ^ k) % 128 = 1 + 8 * ((k + 8 * (k / 2)) % 16) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ, Nat.mul_mod, ih]
    have hp : k % 2 = 0 ∨ k % 2 = 1 := by omega
    rcases hp with h0 | h1 <;> omega

/-- Lemat o 6 krokach parzystych przy podzielności przez 128 (`v₂ ≥ 7`): -/
theorem div2_step6_eq_div128 (N : Nat) (hN : N % 128 = 0) :
    collatzIter 6 (N / 2) = N / 128 := by
  have s1 : collatzStep (N / 2)  = N / 4   := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (N / 4)  = N / 8   := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (N / 8)  = N / 16  := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (N / 16) = N / 32  := by unfold collatzStep; split <;> omega
  have s5 : collatzStep (N / 32) = N / 64  := by unfold collatzStep; split <;> omega
  have s6 : collatzStep (N / 64) = N / 128 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (N / 2)))))) = N / 128
  rw [s1, s2, s3, s4, s5, s6]

/-- TWIERDZENIE O REZONANSIE `mod 128` (`v₂ ≥ 7`) DLA MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 12` KROKACH:
    Ponieważ `(1 + 8s)(7 + 8s) = 64s(s + 1) + 7 ≡ 7 (mod 128)` dla każdego `s ∈ {0..15}`,
    dla `s = (r + 1 + 8 * ((r + 1) / 2)) % 16` oraz prefiksu `U = 128 * W + 7 + 8 * s`
    licznik `9^(r + 1) * U - 7` dzieli się przez `128`, dając po `5r + 12` krokach:
      `collatzIter (5 * r + 12) (U * 2^(3 * r + 3) - 7) = (9^(r + 1) * U - 7) / 128`. -/
theorem two_zero_valley_mod128_resonance_step12 (r W : Nat) :
    let s := (r + 1 + 8 * ((r + 1) / 2)) % 16
    let U := 128 * W + 7 + 8 * s
    collatzIter (5 * r + 12) (U * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * U - 7) / 128 := by
  intro s U
  have h12 : 5 * r + 12 = 6 + (5 * r + 6) := by omega
  have hU : U = 2 * (64 * W + 3 + 4 * s) + 1 := by omega
  rw [h12, collatzIter_add 6 (5 * r + 6), hU, two_zero_valley_odd_prefix_step6_exit r (64 * W + 3 + 4 * s), ← hU]
  have h9_mod128 : (9 ^ (r + 1)) % 128 = 1 + 8 * s := pow9_mod128 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * U = 128 * (9 ^ (r + 1) * W) + (7 + 8 * s) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (128 * W + 7 + 8 * s) = _
    have hU2 : 128 * W + 7 + 8 * s = 128 * W + (7 + 8 * s) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 128, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (7 + 8 * s)]
  have hs : s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3 ∨ s = 4 ∨ s = 5 ∨ s = 6 ∨ s = 7 ∨
            s = 8 ∨ s = 9 ∨ s = 10 ∨ s = 11 ∨ s = 12 ∨ s = 13 ∨ s = 14 ∨ s = 15 := by omega
  have hdiv128 : (9 ^ (r + 1) * U - 7) % 128 = 0 := by
    rcases hs with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7 | h8 | h9 | h10 | h11 | h12 | h13 | h14 | h15
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
    · rw [hdecomp, h4]; omega
    · rw [hdecomp, h5]; omega
    · rw [hdecomp, h6]; omega
    · rw [hdecomp, h7]; omega
    · rw [hdecomp, h8]; omega
    · rw [hdecomp, h9]; omega
    · rw [hdecomp, h10]; omega
    · rw [hdecomp, h11]; omega
    · rw [hdecomp, h12]; omega
    · rw [hdecomp, h13]; omega
    · rw [hdecomp, h14]; omega
    · rw [hdecomp, h15]; omega
  exact div2_step6_eq_div128 (9 ^ (r + 1) * U - 7) hdiv128

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 128` RODZINY `-7` (`r = 0..40`, aż do `2^123`!): -/
theorem two_zero_valley_mod128_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 128 ≤ 128 * 2 ^ (3 * r + 3)) :
    let s := (r + 1 + 8 * ((r + 1) / 2)) % 16
    let U := 128 * W + 7 + 8 * s
    let n0 := U * 2 ^ (3 * r + 3) - 7
    collatzIter (5 * r + 12) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro s U n0
  have hcasc : collatzIter (5 * r + 12) n0 = (9 ^ (r + 1) * U - 7) / 128 :=
    two_zero_valley_mod128_resonance_step12 r W
  have hle : (9 ^ (r + 1) + 128) * U ≤ (128 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 128 (2 ^ (3 * r + 3)) U, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have hX_ge : 135 ≤ 9 ^ (r + 1) * U := by
    cases r with
    | zero =>
      have hs1 : s = 1 := rfl
      have hU15 : U ≥ 15 := by omega
      have h9 : 9 ^ (0 + 1) * U = 9 * U := rfl
      omega
    | succ r' =>
      have hU7 : U ≥ 7 := by omega
      have h81 : 81 ≤ 9 ^ (r' + 1 + 1) := by
        rw [Nat.pow_succ, Nat.pow_succ]
        have := pow9_pos r'
        omega
      have hmul := Nat.mul_le_mul_right U h81
      omega
  have hU_ge7 : U ≥ 7 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 3) - 7 := rfl
  have hlt : collatzIter (5 * r + 12) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 12) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 12) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O REZONANSIE `mod 128` (`v₂ ≥ 7`) DLA MAKRO-EROZJI PRZESUNIĘTEJ (`-5`) W `5r + 12` KROKACH: -/
theorem shifted_valley_mod128_resonance_step12 (r W : Nat) :
    let s := (r + 1 + 8 * ((r + 1) / 2)) % 16
    let U := 128 * W + 5 + 8 * ((3 * s) % 16)
    collatzIter (5 * r + 12) (U * 2 ^ (3 * r + 3) - 5) =
      (9 ^ (r + 1) * U - 5) / 128 := by
  intro s U
  have h12 : 5 * r + 12 = 6 + (5 * r + 6) := by omega
