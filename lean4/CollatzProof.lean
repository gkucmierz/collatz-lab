/-- Twierdzenie o 2-adycznej okresowości potęg dziewiątki modulo 64 (okres 8):
    Ponieważ `9 * (1 + 8m) = 64m + 1 + 8(m + 1)`, dla każdego `k ∈ ℕ` zachodzi:
      `(9^k) % 64 = 1 + 8 * (k % 8)`. -/
theorem pow9_mod64 (k : Nat) : (9 ^ k) % 64 = 1 + 8 * (k % 8) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

/-- Lemat o 5 krokach parzystych przy podzielności przez 64 (`v₂ ≥ 6`): -/
theorem div2_step5_eq_div64 (N : Nat) (hN : N % 64 = 0) :
    collatzIter 5 (N / 2) = N / 64 := by
  have s1 : collatzStep (N / 2) = N / 4 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (N / 4) = N / 8 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (N / 8) = N / 16 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (N / 16) = N / 32 := by unfold collatzStep; split <;> omega
  have s5 : collatzStep (N / 32) = N / 64 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (collatzStep (collatzStep (N / 2))))) = N / 64
  rw [s1, s2, s3, s4, s5]

/-- TWIERDZENIE O REZONANSIE `mod 64` (`v₂ ≥ 6`) DLA MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 11` KROKACH:
    Ponieważ `(1 + 8m)(7 + 8m) = 64m(m + 1) + 7 ≡ 7 (mod 64)` dla każdego `m ∈ {0..7}`,
    dla prefiksu `U = 64 * W + 7 + 8 * ((r + 1) % 8)` licznik `9^(r + 1) * U - 7` dzieli się
    przez `64`, dając po `5r + 11` krokach dokładnie `(9^(r + 1) * U - 7) / 64`: -/
theorem two_zero_valley_mod64_resonance_step11 (r W : Nat) :
    let U := 64 * W + 7 + 8 * ((r + 1) % 8)
    collatzIter (5 * r + 11) (U * 2 ^ (3 * r + 3) - 7) =
      (9 ^ (r + 1) * U - 7) / 64 := by
  intro U
  have h11 : 5 * r + 11 = 5 + (5 * r + 6) := by omega
  have hU : U = 2 * (32 * W + 3 + 4 * ((r + 1) % 8)) + 1 := by omega
  rw [h11, collatzIter_add 5 (5 * r + 6), hU, two_zero_valley_odd_prefix_step6_exit r (32 * W + 3 + 4 * ((r + 1) % 8)), ← hU]
  have h9_mod64 : (9 ^ (r + 1)) % 64 = 1 + 8 * ((r + 1) % 8) := pow9_mod64 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * U = 64 * (9 ^ (r + 1) * W) + (7 + 8 * ((r + 1) % 8)) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (64 * W + 7 + 8 * ((r + 1) % 8)) = _
    have hU2 : 64 * W + 7 + 8 * ((r + 1) % 8) = 64 * W + (7 + 8 * ((r + 1) % 8)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 64, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (7 + 8 * ((r + 1) % 8))]
  have hp : (r + 1) % 8 = 0 ∨ (r + 1) % 8 = 1 ∨ (r + 1) % 8 = 2 ∨ (r + 1) % 8 = 3 ∨
            (r + 1) % 8 = 4 ∨ (r + 1) % 8 = 5 ∨ (r + 1) % 8 = 6 ∨ (r + 1) % 8 = 7 := by omega
  have hdiv64 : (9 ^ (r + 1) * U - 7) % 64 = 0 := by
    rcases hp with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
    · rw [hdecomp, h4]; omega
    · rw [hdecomp, h5]; omega
    · rw [hdecomp, h6]; omega
    · rw [hdecomp, h7]; omega
  exact div2_step5_eq_div64 (9 ^ (r + 1) * U - 7) hdiv64

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 64` RODZINY `-7` (`r = 0..34`, aż do `2^105`!): -/
theorem two_zero_valley_mod64_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 64 ≤ 64 * 2 ^ (3 * r + 3)) :
    let U := 64 * W + 7 + 8 * ((r + 1) % 8)
    let n0 := U * 2 ^ (3 * r + 3) - 7
    collatzIter (5 * r + 11) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro U n0
  have hcasc : collatzIter (5 * r + 11) n0 = (9 ^ (r + 1) * U - 7) / 64 :=
    two_zero_valley_mod64_resonance_step11 r W
  have hle : (9 ^ (r + 1) + 64) * U ≤ (64 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 64 (2 ^ (3 * r + 3)) U, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have hX_ge : 135 ≤ 9 ^ (r + 1) * U := by
    cases r with
    | zero =>
      have hU15 : U ≥ 15 := by omega
      have h9 : 9 ^ (0 + 1) * U = 9 * U := rfl
      omega
    | succ r' =>
      have hU7 : U ≥ 7 := by omega
      have h81 : 81 ≤ 9 ^ (r' + 1 + 1) := by
        rw [Nat.pow_succ, Nat.pow_succ]
        have := pow9_pos r'
        omega
      have hmul := Nat.mul_le_mul_right U h81
      omega
  have hU_ge7 : U ≥ 7 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 3) - 7 := rfl
  have hlt : collatzIter (5 * r + 11) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 11) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 11) n0 (by omega) hge1 hlt⟩

/-- TWIERDZENIE O REZONANSIE `mod 64` (`v₂ ≥ 6`) DLA MAKRO-EROZJI PRZESUNIĘTEJ (`-5`) W `5r + 11` KROKACH: -/
theorem shifted_valley_mod64_resonance_step11 (r W : Nat) :
    let U := 64 * W + 5 + 8 * ((3 * ((r + 1) % 8)) % 8)
    collatzIter (5 * r + 11) (U * 2 ^ (3 * r + 3) - 5) =
      (9 ^ (r + 1) * U - 5) / 64 := by
  intro U
  have h11 : 5 * r + 11 = 5 + (5 * r + 6) := by omega
  have hU : U = 2 * (32 * W + 2 + 4 * ((3 * ((r + 1) % 8)) % 8)) + 1 := by omega
  rw [h11, collatzIter_add 5 (5 * r + 6), hU, shifted_valley_odd_prefix_step6_exit r (32 * W + 2 + 4 * ((3 * ((r + 1) % 8)) % 8)) (by omega), ← hU]
  have h9_mod64 : (9 ^ (r + 1)) % 64 = 1 + 8 * ((r + 1) % 8) := pow9_mod64 (r + 1)
  have h9_ge9 : 9 ≤ 9 ^ (r + 1) := by
    rw [Nat.pow_succ]
    have := pow9_pos r
    omega
  have hdecomp : 9 ^ (r + 1) * U = 64 * (9 ^ (r + 1) * W) + (5 + 8 * ((3 * ((r + 1) % 8)) % 8)) * 9 ^ (r + 1) := by
    show 9 ^ (r + 1) * (64 * W + 5 + 8 * ((3 * ((r + 1) % 8)) % 8)) = _
    have hU2 : 64 * W + 5 + 8 * ((3 * ((r + 1) % 8)) % 8) = 64 * W + (5 + 8 * ((3 * ((r + 1) % 8)) % 8)) := by omega
    rw [hU2, Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) 64, Nat.mul_assoc, Nat.mul_comm (9 ^ (r + 1)) (5 + 8 * ((3 * ((r + 1) % 8)) % 8))]
  have hp : (r + 1) % 8 = 0 ∨ (r + 1) % 8 = 1 ∨ (r + 1) % 8 = 2 ∨ (r + 1) % 8 = 3 ∨
            (r + 1) % 8 = 4 ∨ (r + 1) % 8 = 5 ∨ (r + 1) % 8 = 6 ∨ (r + 1) % 8 = 7 := by omega
  have hdiv64 : (9 ^ (r + 1) * U - 5) % 64 = 0 := by
    rcases hp with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
    · rw [hdecomp, h0]; omega
    · rw [hdecomp, h1]; omega
    · rw [hdecomp, h2]; omega
    · rw [hdecomp, h3]; omega
    · rw [hdecomp, h4]; omega
    · rw [hdecomp, h5]; omega
    · rw [hdecomp, h6]; omega
    · rw [hdecomp, h7]; omega
  exact div2_step5_eq_div64 (9 ^ (r + 1) * U - 5) hdiv64

/-- TWIERDZENIE O BEZWARUNKOWEJ KONTRAKCJI REZONANSU `mod 64` RODZINY `-5` (`r = 0..34`, aż do `2^105`!): -/
theorem shifted_valley_mod64_contraction (r W : Nat)
    (hr : 9 ^ (r + 1) + 64 ≤ 64 * 2 ^ (3 * r + 3)) :
    let U := 64 * W + 5 + 8 * ((3 * ((r + 1) % 8)) % 8)
    let n0 := U * 2 ^ (3 * r + 3) - 5
    collatzIter (5 * r + 11) n0 < n0 ∧ HasHorizonDrop n0 := by
  intro U n0
  have hcasc : collatzIter (5 * r + 11) n0 = (9 ^ (r + 1) * U - 5) / 64 :=
    shifted_valley_mod64_resonance_step11 r W
  have hle : (9 ^ (r + 1) + 64) * U ≤ (64 * 2 ^ (3 * r + 3)) * U :=
    Nat.mul_le_mul_right U hr
  rw [Nat.add_mul, Nat.mul_assoc 64 (2 ^ (3 * r + 3)) U, Nat.mul_comm (2 ^ (3 * r + 3)) U] at hle
  have hX_ge : 261 ≤ 9 ^ (r + 1) * U := by
    cases r with
    | zero =>
      have hU29 : U ≥ 29 := by omega
      have h9 : 9 ^ (0 + 1) * U = 9 * U := rfl
      omega
    | succ r' =>
      have hU5 : U ≥ 5 := by omega
      have h81 : 81 ≤ 9 ^ (r' + 1 + 1) := by
        rw [Nat.pow_succ, Nat.pow_succ]
        have := pow9_pos r'
        omega
      have hmul := Nat.mul_le_mul_right U h81
      omega
  have hU_ge5 : U ≥ 5 := by omega
  have hn0 : n0 = U * 2 ^ (3 * r + 3) - 5 := rfl
  have hlt : collatzIter (5 * r + 11) n0 < n0 := by
    rw [hcasc, hn0]
    omega
  have hge1 : collatzIter (5 * r + 11) n0 ≥ 1 := by
    rw [hcasc]
    omega
  exact ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (5 * r + 11) n0 (by omega) hge1 hlt⟩

