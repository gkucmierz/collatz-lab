  have s2 : collatzStep (N / 4) = N / 8 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (N / 8) = N / 16 := by unfold collatzStep; split <;> omega
  change collatzStep (collatzStep (collatzStep (N / 2))) = N / 16
  rw [s1, s2, s3]

/-- TWIERDZENIE O REZONANSIE `mod 16` (`v₂ ≥ 4`) DLA MAKRO-EROZJI DWU-ZEROWEJ (`-7`) W `5r + 9` KROKACH:
