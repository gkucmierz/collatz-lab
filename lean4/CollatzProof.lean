/-- TWIERDZENIE O REZONANSIE `mod 1024` (`v₂ ≥ 10`) RODZINY `-5` W FAZIE `3r + 1` (`shifted_valley_d1`) W `5r + 12` KROKACH: -/
theorem shifted_valley_d1_mod1024_resonance_step12 (r W : Nat) :
    let s := (r + 8 * (r / 2) + 80 * (r / 4) + 80 * ((r + 1) / 4) +
              32 * (r / 8) + 32 * ((r + 1) / 8) + 32 * ((r + 2) / 8) + 32 * ((r + 3) / 8) +
              64 * (r / 16) + 64 * ((r + 1) / 16) + 64 * ((r + 2) / 16) + 64 * ((r + 3) / 16) +
              64 * ((r + 4) / 16) + 64 * ((r + 5) / 16) + 64 * ((r + 6) / 16) + 64 * ((r + 7) / 16)) % 128
    let U := 1024 * W + 5 + 8 * ((27 * s + 85 + 16 * (s / 2) + 32 * ((s + 2) / 4) + 32 * ((s + 3) / 4) +
              64 * ((s + 1) / 8) + 64 * ((s + 2) / 8) + 64 * ((s + 4) / 8) + 64 * ((s + 7) / 8)) % 128)
    collatzIter (5 * r + 12) (U * 2 ^ (3 * r + 1) - 5) =
      (3 * 9 ^ r * U - 7) / 1024 := by
  intro s U
  generalize ht : (27 * s + 85 + 16 * (s / 2) + 32 * ((s + 2) / 4) + 32 * ((s + 3) / 4) +
    64 * ((s + 1) / 8) + 64 * ((s + 2) / 8) + 64 * ((s + 4) / 8) + 64 * ((s + 7) / 8)) % 128 = t
  have hs_lt : s < 128 := Nat.mod_lt _ (by decide)
  have hU_def : U = 1024 * W + 5 + 8 * t := by dsimp [U]; rw [ht]
  have h12 : 5 * r + 12 = 9 + (5 * r + 3) := by omega
  have hU : U = 2 * (512 * W + 2 + 4 * t) + 1 := by omega
  rw [h12, collatzIter_add 9 (5 * r + 3), hU, shifted_valley_d1_odd_prefix_step3_exit r (512 * W + 2 + 4 * t) (by omega), ← hU]
  have h9_mod1024 : (9 ^ r) % 1024 = 1 + 8 * s := pow9_mod1024 r
  have hU_assoc : U = 1024 * W + (5 + 8 * t) := by omega
  have hres : (3 * (5 + 8 * t) * (1 + 8 * s)) % 1024 = 7 % 1024 := by
    rw [← ht]
    exact checkResonanceTable_sound 1024 3 5 7
      (fun x => (27 * x + 85 + 16 * (x / 2) + 32 * ((x + 2) / 4) + 32 * ((x + 3) / 4) +
        64 * ((x + 1) / 8) + 64 * ((x + 2) / 8) + 64 * ((x + 4) / 8) + 64 * ((x + 7) / 8)) % 128)
      128 s (by decide) hs_lt
  have hdiv1024 : (3 * 9 ^ r * U - 7) % 1024 = 0 := by
    rw [hU_assoc]
    exact mod1024_linear_inverse 3 (9 ^ r) W (5 + 8 * t) 7 (1 + 8 * s) h9_mod1024 hres
  exact div2_step9_eq_div1024 (3 * 9 ^ r * U - 7) hdiv1024

