-- CZĘŚĆ 22. WSTRZYKNIĘCIE Z DOLINY WIELOZERA `...00011₂` DO PRÓŻNI `Z * 4^r + 1`
--           W 7 KROKACH, PEŁNA KASKADA `3r + 7` KROKÓW ORAZ RODZINY `M_{41}..M_{48}`
-- =============================================================================

/-- Lemat o 7-krokowym wstrzyknięciu sufiksu `...00011₂` (`Y * 32 + 3`) bezpośrednio
    w stan próżni doliny zerowej `9 * Y + 1`:
    Po 2 krokach nieparzystych i 5 dzieleniach przez 2 (`v₂ = 1` oraz `v₂ = 4`)
    każda liczba `Y * 32 + 3` przechodzi w `9 * Y + 1 < Y * 32 + 3` (dla każdego `Y ≥ 0`!). -/
theorem rle_00011_step7_to_vacuum (Y : Nat) :
    collatzIter 7 (Y * 32 + 3) = 9 * Y + 1 ∧ 9 * Y + 1 < Y * 32 + 3 := by
  have s1 : collatzStep (Y * 32 + 3) = 96 * Y + 10 := by unfold collatzStep; split <;> omega
  have s2 : collatzStep (96 * Y + 10) = 48 * Y + 5 := by unfold collatzStep; split <;> omega
  have s3 : collatzStep (48 * Y + 5) = 144 * Y + 16 := by unfold collatzStep; split <;> omega
  have s4 : collatzStep (144 * Y + 16) = 72 * Y + 8 := by unfold collatzStep; split <;> omega
  have s5 : collatzStep (72 * Y + 8) = 36 * Y + 4 := by unfold collatzStep; split <;> omega
  have s6 : collatzStep (36 * Y + 4) = 18 * Y + 2 := by unfold collatzStep; split <;> omega
  have s7 : collatzStep (18 * Y + 2) = 9 * Y + 1 := by unfold collatzStep; split <;> omega
  refine ⟨?_, by omega⟩
  simp [collatzIter, s1, s2, s3, s4, s5, s6, s7]

/-- TWIERDZENIE O SPRZĘŻONEJ KASKADZIE WIELOZERO-PRÓŻNIA (`rle_00011_multi_zero_vacuum_cascade`):
    Dla dowolnej liczby postaci `(Q * 4^r) * 32 + 3` (sufiks `11₂` poprzedzony doliną `2 * r + 3` zer):
    po dokładnie `3 * r + 7` klasycznych krokach Collatza (7 kroków wstrzyknięcia do próżni +
    `3 * r` kroków kompresji próżniowej `zero_valley_vacuum_inductive`) trajektoria osiąga
    dokładnie stan `3^r * (9 * Q) + 1`! -/
theorem rle_00011_multi_zero_vacuum_cascade (r Q : Nat) :
    collatzIter (3 * r + 7) ((Q * 4 ^ r) * 32 + 3) = 3 ^ r * (9 * Q) + 1 := by
  rw [collatzIter_add (3 * r) 7]
  rw [(rle_00011_step7_to_vacuum (Q * 4 ^ r)).1]
  have hmul : 9 * (Q * 4 ^ r) = (9 * Q) * 4 ^ r := by
    rw [← Nat.mul_assoc]
  rw [hmul]
  exact zero_valley_vacuum_inductive r (9 * Q)

/-- Elementarna monotoniczność wykładnicza `3^r ≤ 4^r` dla każdego `r : Nat`: -/
theorem pow3_le_pow4 (r : Nat) : 3 ^ r ≤ 4 ^ r := by
  induction r with
  | zero => omega
  | succ r ih =>
    rw [Nat.pow_succ 3 r, Nat.pow_succ 4 r]
    omega

/-- Pomocniczy lemat łączący ścisły spadek `collatzIter m n < n` przy zachowaniu `collatzIter m n ≥ 1`
    bezpośrednio z predykatem `HasHorizonDrop n`: -/
theorem hasHorizonDrop_of_ge_one_and_lt (m n : Nat) (hm : m > 0)
    (hge1 : collatzIter m n ≥ 1) (hlt : collatzIter m n < n) :
    HasHorizonDrop n := by
  refine ⟨m, hm, ?_⟩
  unfold V_id
  omega

/-- Bezwarunkowy spadek po `3 * r + 7` krokach dla całej dwuparametrowej rodziny `(Q * 4^r) * 32 + 3`: -/
theorem rle_00011_multi_zero_unconditional_drop (r Q : Nat) :
    collatzIter (3 * r + 7) ((Q * 4 ^ r) * 32 + 3) < (Q * 4 ^ r) * 32 + 3 ∧
    HasHorizonDrop ((Q * 4 ^ r) * 32 + 3) := by
  have hcasc := rle_00011_multi_zero_vacuum_cascade r Q
  have hpow : 3 ^ r ≤ 4 ^ r := pow3_le_pow4 r
  have hmulQ : (3 ^ r) * Q ≤ (4 ^ r) * Q := Nat.mul_le_mul_right Q hpow
  have hrew1 : 3 ^ r * (9 * Q) = 9 * (3 ^ r * Q) := by
    rw [← Nat.mul_assoc, Nat.mul_comm (3 ^ r) 9, Nat.mul_assoc]
  have hrew2 : (Q * 4 ^ r) * 32 = 32 * (4 ^ r * Q) := by
    rw [Nat.mul_comm Q (4 ^ r), Nat.mul_comm (4 ^ r * Q) 32]
  have hlt : collatzIter (3 * r + 7) ((Q * 4 ^ r) * 32 + 3) < (Q * 4 ^ r) * 32 + 3 := by
    rw [hcasc, hrew1, hrew2]
    omega
  have hge1 : collatzIter (3 * r + 7) ((Q * 4 ^ r) * 32 + 3) ≥ 1 := by
    rw [hcasc]
    omega
  refine ⟨hlt, hasHorizonDrop_of_ge_one_and_lt (3 * r + 7) _ (by omega) hge1 hlt⟩

