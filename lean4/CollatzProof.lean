-- Część 48: Architektura Tablicowo-Liniowa (`checkResonanceTable` + `mod256_linear_inverse`),
--           Rezonans 2-Adyczny `mod 256` (`v₂ ≥ 8`) dla Wszystkich 4 Pozostałych Faz Modulo-3
--           (`shifted_valley_d1`, `two_zero_valley_d5`, `two_zero_valley_d4`, `shifted_valley_d2`)
--           oraz 96 Twierdzeń o Kontrakcji dla Poziomów k = 153..161 (m = 249..262)
-- ============================================================================

/-- Rekurencyjny weryfikator tablicy rezonansu 2-adycznego dla wszystkich `s ∈ {0..n-1}`:
    Sprawdza, czy dla funkcji fazowej `tFn : Nat → Nat` oraz `u0 = uBase + 8 * tFn s`
    zachodzi kongruencja `(A * u0 * (1 + 8 * s)) % K == c % K`. -/
def checkResonanceTable (K A uBase c : Nat) (tFn : Nat → Nat) : Nat → Bool
  | 0 => true
  | s + 1 =>
    let u0 := uBase + 8 * tFn s
    let ok := (A * u0 * (1 + 8 * s)) % K == c % K
    ok && checkResonanceTable K A uBase c tFn s

theorem bool_and_eq_true_iff (a b : Bool) : (a && b) = true → a = true ∧ b = true := by
  cases a <;> cases b <;> decide

/-- Twierdzenie o poprawności `checkResonanceTable`: zastępuje 32-gałęziowe (lub 64-gałęziowe)
    `rcases hs` pojedynczym wywołaniem `(by decide)`! -/
theorem checkResonanceTable_sound (K A uBase c : Nat) (tFn : Nat → Nat) (n s : Nat)
    (h : checkResonanceTable K A uBase c tFn n = true) (hs : s < n) :
    (A * (uBase + 8 * tFn s) * (1 + 8 * s)) % K = c % K := by
  induction n with
  | zero => omega
  | succ n ih =>
    unfold checkResonanceTable at h
    have ⟨h1, h2⟩ := bool_and_eq_true_iff _ _ h
    have hlt : s = n ∨ s < n := by omega
    rcases hlt with rfl | hlt
    · exact of_decide_eq_true h1
    · exact ih h2 hlt

/-- Lemat o liniowej inwersji `mod 256` (`mod256_linear_inverse`):
    Redukuje podzielność `(A * M * (256 * W + u0) - c) % 256 = 0` dla dowolnej potęgi `M = 9^k`
    do skończonej kongruencji `(A * u0 * b) % 256 = c % 256` na reszcie `b = M % 256`,
    całkowicie eliminując potrzebę rozbijania na 32 przypadki w każdym twierdzeniu! -/
theorem mod256_linear_inverse (A M W u0 c b : Nat)
    (hM : M % 256 = b)
    (hres : (A * u0 * b) % 256 = c % 256) :
    (A * M * (256 * W + u0) - c) % 256 = 0 := by
  have hdecomp : A * M * (256 * W + u0) = 256 * (A * M * W) + A * u0 * M := by
    rw [Nat.mul_add, ← Nat.mul_assoc (A * M) 256 W, Nat.mul_comm (A * M) 256,
        Nat.mul_assoc 256 (A * M) W, Nat.mul_assoc A M u0, Nat.mul_comm M u0, ← Nat.mul_assoc A u0 M]
  have hmod1 : (A * u0 * M) % 256 = (A * u0 * b) % 256 := by
    rw [Nat.mul_mod (A * u0) M 256, hM, Nat.mul_mod (A * u0) b 256]
    have hb : b % 256 = b := by omega
    rw [hb]
  have hmod2 : (A * u0 * M) % 256 = c % 256 := by rw [hmod1, hres]
  omega

/-- Analogiczny lemat o liniowej inwersji `mod 512` (`mod512_linear_inverse`) dla `v₂ ≥ 9`: -/
theorem mod512_linear_inverse (A M W u0 c b : Nat)
    (hM : M % 512 = b)
    (hres : (A * u0 * b) % 512 = c % 512) :
    (A * M * (512 * W + u0) - c) % 512 = 0 := by
  have hdecomp : A * M * (512 * W + u0) = 512 * (A * M * W) + A * u0 * M := by
    rw [Nat.mul_add, ← Nat.mul_assoc (A * M) 512 W, Nat.mul_comm (A * M) 512,
        Nat.mul_assoc 512 (A * M) W, Nat.mul_assoc A M u0, Nat.mul_comm M u0, ← Nat.mul_assoc A u0 M]
  have hmod1 : (A * u0 * M) % 512 = (A * u0 * b) % 512 := by
    rw [Nat.mul_mod (A * u0) M 512, hM, Nat.mul_mod (A * u0) b 512]
    have hb : b % 512 = b := by omega
    rw [hb]
  have hmod2 : (A * u0 * M) % 512 = c % 512 := by rw [hmod1, hres]
  omega

